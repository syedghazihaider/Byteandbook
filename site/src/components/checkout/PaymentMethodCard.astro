---
// Purely informational card describing a potential future payment
// method. Never renders a button, form, or account/merchant detail —
// only a name, description, and honest availability status — so a
// method can be flipped to "Available" later without redesigning the
// page, and nothing here ever implies a provider is configured before
// it actually is.
interface Props {
  name: string;
  description: string;
  available?: boolean;
}
const { name, description, available = false } = Astro.props;
---

<div class="flex items-start justify-between gap-4 rounded-bb-lg border border-ink-700 bg-ink-900/60 p-5">
  <div>
    <h3 class="text-sm font-semibold text-ink-50">{name}</h3>
    <p class="mt-1 text-sm text-ink-300">{description}</p>
  </div>
  <span
    class:list={[
      'shrink-0 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.08em]',
      available ? 'bg-signal-500/10 text-signal-400' : 'border border-ink-600 text-ink-400',
    ]}
  >
    {available ? 'Available' : 'Not yet available'}
  </span>
</div>
