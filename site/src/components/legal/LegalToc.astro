---
// Lightweight in-page table of contents for long legal documents —
// plain anchor links to each section's id, so the content stays
// keyboard/screen-reader navigable without any JS.
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Table of contents" class="rounded-bb-lg border border-ink-700 bg-ink-900/60 p-6">
  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-300">On this page</p>
  <ol class="mt-4 grid gap-x-6 gap-y-2 sm:grid-cols-2">
    {items.map((item, i) => (
      <li>
        <a href={`#${item.id}`} class="text-sm text-ink-300 hover:text-signal-300">
          {i + 1}. {item.label}
        </a>
      </li>
    ))}
  </ol>
</nav>
