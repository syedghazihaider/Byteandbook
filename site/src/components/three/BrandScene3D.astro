---
// Level 1 showcase for Branding: flow steps climb an ascending,
// color-shifting helix of low-poly facets. Drag to rotate.
interface Props {
  steps: string[];
}
const { steps } = Astro.props;
---

<div
  class="relative mx-auto h-[340px] w-full max-w-4xl sm:h-[420px]"
  data-brand-scene
  data-steps={JSON.stringify(steps)}
>
  <canvas class="h-full w-full touch-none cursor-grab active:cursor-grabbing" aria-hidden="true"></canvas>
  <div class="pointer-events-none absolute inset-0" data-labels></div>
  <p class="pointer-events-none absolute bottom-3 left-1/2 -translate-x-1/2 text-xs text-ink-300">Drag to rotate</p>
</div>

<script>
  import { createBrandScene } from '../../scripts/three/brandScene';
  import { shouldRunHeavyMotion, onVisibilityChange, safeMountScene } from '../../scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-brand-scene]').forEach((container) => {
    const canvas = container.querySelector<HTMLCanvasElement>('canvas');
    const labelsRoot = container.querySelector<HTMLElement>('[data-labels]');
    if (!canvas || !labelsRoot) return;
    if (!shouldRunHeavyMotion()) {
      container.remove();
      return;
    }

    const steps: string[] = JSON.parse(container.dataset.steps || '[]');

    const labelEls = steps.map((label) => {
      const el = document.createElement('div');
      el.className =
        'absolute -translate-x-1/2 -translate-y-1/2 whitespace-nowrap rounded-full border border-ink-700 bg-ink-950/85 px-2.5 py-1 text-[11px] font-medium text-ink-200 opacity-0 transition-opacity duration-200';
      el.textContent = label;
      labelsRoot.appendChild(el);
      return el;
    });

    let handle: ReturnType<typeof createBrandScene> | null = null;
    onVisibilityChange(
      container,
      () => {
        handle = safeMountScene(() =>
          createBrandScene(canvas, {
            steps,
            onUpdate: (positions) => {
              positions.forEach((pos, i) => {
                const el = labelEls[i];
                if (!el) return;
                el.style.left = `${pos.x}px`;
                el.style.top = `${pos.y}px`;
                el.style.opacity = pos.visible ? '1' : '0';
              });
            },
          })
        );
        if (!handle) {
          container.remove();
          return;
        }
        handle.start();
      },
      () => {
        handle?.stop();
        handle?.dispose();
        handle = null;
      }
    );
  });
</script>
