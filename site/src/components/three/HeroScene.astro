---
// Level 1 homepage hero visual. Absolutely positioned over the static
// CSS grid/glow backdrop already in index.astro — that backdrop is the
// reduced-motion / no-WebGL / no-JS / render-failure / mobile fallback;
// this canvas mounts on top of it only on desktop-class viewports (see
// shouldRunHeroInteractive3D in scripts/motion.ts — Phase 2 turns off
// heavy WebGL on mobile for the hero specifically, unlike other Level 1
// scenes which still run a compact tier there).
//
// Phase 2: three of the constellation's nodes are real, pillar-colored
// "category" markers (one per CATEGORIES entry) — hoverable/clickable
// via raycasting, with an HTML label pill projected over each. Clicking
// one navigates to that category's page; this is a mouse-only bonus
// layered over the actual <a> cards in the section below, which remain
// the real, always-present, keyboard/screen-reader-reachable mechanism.
import { CATEGORIES } from '../../lib/categories';

const categoriesData = CATEGORIES.map((c) => ({ label: c.navLabel, href: c.path, accentVar: c.accentVar }));
---

<div class="pointer-events-none absolute inset-0" data-hero-scene data-categories={JSON.stringify(categoriesData)}>
  <canvas class="h-full w-full" aria-hidden="true"></canvas>
  <div class="pointer-events-none absolute inset-0" data-hero-labels aria-hidden="true"></div>
</div>

<script>
  import { shouldRunHeroInteractive3D, onVisibilityChange, safeMountScene } from '../../scripts/motion';
  import type { CategoryMarker } from '../../scripts/three/heroScene';

  const container = document.querySelector<HTMLElement>('[data-hero-scene]');
  const canvas = container?.querySelector<HTMLCanvasElement>('canvas');
  const labelsRoot = container?.querySelector<HTMLElement>('[data-hero-labels]');

  if (container && canvas && labelsRoot && shouldRunHeroInteractive3D()) {
    const categories: CategoryMarker[] = JSON.parse(container.dataset.categories || '[]');

    const labelEls = categories.map((cat) => {
      const el = document.createElement('a');
      el.href = cat.href;
      el.className =
        'pointer-events-none absolute -translate-x-1/2 -translate-y-1/2 whitespace-nowrap rounded-full border border-ink-700 bg-ink-950/85 px-3 py-1.5 text-xs font-semibold text-ink-100 opacity-0 transition-[opacity,transform] duration-200';
      el.textContent = cat.label;
      el.tabIndex = -1; // decorative duplicate of the real card link below; never a tab stop
      el.setAttribute('aria-hidden', 'true');
      labelsRoot.appendChild(el);
      return el;
    });

    let scene: ReturnType<typeof import('../../scripts/three/heroScene')['createHeroScene']> | null = null;
    let scrollTrigger: import('gsap/ScrollTrigger').ScrollTrigger | null = null;

    onVisibilityChange(
      container,
      async () => {
        // Dynamic import: the shared Three.js chunk is only fetched once
        // shouldRunHeroInteractive3D() has already passed and this scene
        // is actually about to mount — mobile and reduced-motion visitors
        // never download it at all.
        const { createHeroScene } = await import('../../scripts/three/heroScene');
        scene = safeMountScene(() =>
          createHeroScene(canvas, categories, (positions) => {
            positions.forEach((pos, i) => {
              const el = labelEls[i];
              if (!el) return;
              el.style.left = `${pos.x}px`;
              el.style.top = `${pos.y - 26}px`;
              el.style.opacity = pos.visible ? (pos.hovered ? '1' : '0.7') : '0';
              el.style.transform = `translate(-50%, -50%) scale(${pos.hovered ? 1.08 : 1})`;
            });
          })
        );
        if (!scene) {
          container.remove();
          return;
        }
        scene.start();

        if (!scrollTrigger) {
          const { gsap } = await import('gsap');
          const { ScrollTrigger } = await import('gsap/ScrollTrigger');
          gsap.registerPlugin(ScrollTrigger);
          const heroSection = container.closest('section');
          scrollTrigger = ScrollTrigger.create({
            trigger: heroSection ?? container,
            start: 'top top',
            end: 'bottom top',
            scrub: true,
            onUpdate: (self) => scene?.setScrollProgress(self.progress),
          });
        }
      },
      () => {
        scene?.stop();
        scene?.dispose();
        scene = null;
      }
    );
  }
</script>
