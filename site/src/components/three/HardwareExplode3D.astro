---
// Level 1 showcase for Computer Hardware: hand-built exploded
// workstation (no external 3D model assets). Drag to rotate; the
// "Explode view" button separates the parts and reveals labels.
---

<div class="mx-auto max-w-4xl" data-hardware-scene>
  <div class="relative h-[340px] w-full sm:h-[420px]">
    <canvas class="h-full w-full touch-none cursor-grab active:cursor-grabbing" aria-hidden="true"></canvas>
    <div class="pointer-events-none absolute inset-0" data-labels></div>
  </div>
  <div class="mt-6 flex flex-col items-center gap-3">
    <button
      type="button"
      data-explode-toggle
      class="inline-flex items-center gap-2 rounded-bb-md border border-ink-600 px-5 py-2.5 text-sm font-semibold text-ink-100 transition-colors hover:border-signal-400 hover:text-signal-300"
      aria-pressed="false"
    >
      Explode view
    </button>
    <p class="text-xs text-ink-300">Drag to rotate</p>
  </div>
</div>

<script>
  import { createHardwareScene } from '../../scripts/three/hardwareScene';
  import { shouldRunHeavyMotion, onVisibilityChange, safeMountScene } from '../../scripts/motion';

  const container = document.querySelector<HTMLElement>('[data-hardware-scene]');
  const canvas = container?.querySelector<HTMLCanvasElement>('canvas');
  const labelsRoot = container?.querySelector<HTMLElement>('[data-labels]');
  const toggle = container?.querySelector<HTMLButtonElement>('[data-explode-toggle]');

  if (container && canvas && labelsRoot && toggle && shouldRunHeavyMotion()) {
    const labelEls = new Map<string, HTMLElement>();

    let handle: ReturnType<typeof createHardwareScene> | null = null;
    let exploded = false;

    onVisibilityChange(
      container,
      () => {
        handle = safeMountScene(() =>
          createHardwareScene(canvas, {
            onUpdate: (labels) => {
              labels.forEach((label) => {
                let el = labelEls.get(label.key);
                if (!el) {
                  el = document.createElement('div');
                  el.className =
                    'absolute -translate-x-1/2 translate-y-3 whitespace-nowrap rounded-full border border-ink-700 bg-ink-950/85 px-2.5 py-1 text-[11px] font-medium text-ink-200 transition-opacity duration-200';
                  labelsRoot.appendChild(el);
                  el.textContent = label.key;
                  labelEls.set(label.key, el);
                }
                el.style.left = `${label.x}px`;
                el.style.top = `${label.y}px`;
                el.style.opacity = label.visible ? String(label.opacity) : '0';
              });
            },
          })
        );
        if (!handle) {
          container.remove();
          return;
        }
        handle.start();
        handle.setExploded(exploded);
      },
      () => {
        handle?.stop();
        handle?.dispose();
        handle = null;
      }
    );

    toggle.addEventListener('click', () => {
      exploded = !exploded;
      toggle.setAttribute('aria-pressed', String(exploded));
      toggle.textContent = exploded ? 'Assemble view' : 'Explode view';
      handle?.setExploded(exploded);
    });
  } else if (container) {
    // No heavy motion (reduced-motion / no WebGL support) — collapse the
    // whole scene rather than leaving an empty canvas box and a dead
    // toggle button. Mobile no longer hits this branch on its own.
    container.remove();
  }
</script>
