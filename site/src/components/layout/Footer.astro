---
import Container from '../ui/Container.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-ink-800 bg-ink-950 py-12">
  <Container class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
    <div class="max-w-xs">
      <a href="/" class="font-display text-lg font-bold text-ink-50">
        Byte<span class="text-signal-400">&amp;</span>Book
      </a>
      <p class="mt-3 text-sm text-ink-400">
        Digital technology &amp; growth agency — design, engineering, and
        infrastructure built as one connected system.
      </p>
    </div>

    <nav class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-300">
      <a href="/#services" class="hover:text-ink-50">Services</a>
      <a href="/#approach" class="hover:text-ink-50">Approach</a>
      <a href="/contact" class="hover:text-ink-50">Contact</a>
    </nav>
  </Container>

  <Container class="mt-10 border-t border-ink-800 pt-6 text-xs text-ink-500">
    &copy; {year} ByteAndBook. All rights reserved.
  </Container>
</footer>
