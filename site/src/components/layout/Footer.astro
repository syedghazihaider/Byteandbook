---
import Container from '../ui/Container.astro';
import { SITE_SOCIAL } from '../../config/site';

const year = new Date().getFullYear();
const EMAIL = 'info@byteandbook.com';

// V2-5: only renders entries with a real, verified URL in
// config/site.ts — currently none, so this list (and the "Elsewhere"
// nav below) is empty and nothing renders. No "#" placeholder links.
const socialLinks = (
  [
    { label: 'LinkedIn', url: SITE_SOCIAL.linkedin },
    { label: 'GitHub', url: SITE_SOCIAL.github },
    { label: 'Clutch', url: SITE_SOCIAL.clutch },
    { label: 'Trustpilot', url: SITE_SOCIAL.trustpilot },
  ] as const
).filter((link): link is { label: string; url: string } => typeof link.url === 'string' && link.url.length > 0);
---

<footer class="border-t border-ink-800 bg-ink-950 py-12">
  <Container class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
    <div class="max-w-xs">
      <a href="/" class="font-display text-lg font-bold text-ink-50">
        Byte<span class="text-signal-400">&amp;</span>Book
      </a>
      <p class="mt-3 text-sm text-ink-300">
        Remote-first digital technology &amp; growth agency — design, engineering, and
        infrastructure built as one connected system.
      </p>
      <a href={`mailto:${EMAIL}`} class="mt-4 inline-block text-sm font-medium text-ink-200 hover:text-signal-300">
        {EMAIL}
      </a>
    </div>

    <nav aria-label="Footer" class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-300">
      <a href="/services/" class="hover:text-ink-50">Services</a>
      <a href="/process/" class="hover:text-ink-50">Process</a>
      <a href="/about/" class="hover:text-ink-50">About</a>
      <a href="/work/" class="hover:text-ink-50">Work</a>
      <a href="/insights/" class="hover:text-ink-50">Insights</a>
      <a href="/contact/" class="hover:text-ink-50">Contact</a>
      <a href="/checkout/" class="hover:text-ink-50">Checkout</a>
    </nav>

    {socialLinks.length > 0 && (
      <nav aria-label="Elsewhere" class="flex flex-wrap gap-x-6 gap-y-3 text-sm text-ink-300">
        {socialLinks.map((link) => (
          <a href={link.url} target="_blank" rel="noopener" class="hover:text-ink-50">{link.label}</a>
        ))}
      </nav>
    )}
  </Container>

  <Container class="mt-10 flex flex-col gap-4 border-t border-ink-800 pt-6 text-xs text-ink-300 sm:flex-row sm:items-center sm:justify-between">
    <span>&copy; {year} ByteAndBook. All rights reserved.</span>
    <nav aria-label="Legal" class="flex flex-wrap gap-x-6 gap-y-2">
      <a href="/terms/" class="hover:text-ink-100">Terms of Service</a>
      <a href="/privacy/" class="hover:text-ink-100">Privacy Policy</a>
      <a href="/refund-policy/" class="hover:text-ink-100">Refund &amp; Cancellation Policy</a>
    </nav>
  </Container>
</footer>
