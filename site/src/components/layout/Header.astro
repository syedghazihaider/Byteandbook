---
import Container from '../ui/Container.astro';
import StartProjectTrigger from '../project/StartProjectTrigger.astro';
import { CATEGORIES } from '../../lib/categories';

// V2-1: true multi-page primary navigation. Every entry is a standalone
// route — no homepage-anchor destinations (/#services, /#approach) for
// primary nav, per the V2-1 correction. Homepage anchors remain valid
// only for in-page scrolling on the homepage itself.
// Phase 1-IA: "Services" became an accessible disclosure menu listing
// the 3 public categories (see lib/categories.ts) instead of a plain
// link — the other three entries stay plain links.
// Proof pages grouped under a "Work" disclosure menu (same pattern as
// Services). Only pages that exist and hold real material belong here.
const workLinks = [
  { label: 'Work', hint: 'Selected engagements and how we approach them', href: '/work/' },
  { label: 'Case Studies', hint: 'Anonymized write-ups of real projects', href: '/case-studies/' },
  { label: 'Team Track Record', hint: 'Verified client reviews and video feedback', href: '/team-track-record/' },
];
const navLinks = [
  { label: 'Process', href: '/process/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-ink-800/80 bg-ink-950/80 backdrop-blur-md">
  <Container class="flex items-center justify-between py-4">
    <a href="/" class="font-display text-xl font-bold tracking-tight text-ink-50">
      Byte<span class="text-signal-400">&amp;</span>Book
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-8 text-sm font-medium text-ink-300 md:flex">
      <div class="relative" data-services-menu>
        <button
          type="button"
          id="services-menu-toggle"
          class="flex items-center gap-1.5 transition-colors hover:text-ink-50"
          aria-expanded="false"
          aria-controls="services-menu-panel"
        >
          Services
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class="h-4 w-4 transition-transform" aria-hidden="true" data-services-menu-chevron>
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>
        <div
          id="services-menu-panel"
          class="absolute left-1/2 top-full hidden w-80 -translate-x-1/2 pt-3"
          data-services-menu-panel
        >
          <ul class="rounded-bb-lg border border-ink-700 bg-ink-900 p-2 shadow-[0_10px_40px_-12px_rgba(0,0,0,0.55)]">
            {CATEGORIES.map((category) => (
              <li>
                <a href={category.path} class="block rounded-bb-sm px-4 py-3 hover:bg-ink-800">
                  <span class="block text-sm font-semibold text-ink-50">{category.navLabel}</span>
                  <span class="mt-0.5 block text-xs text-ink-300">{category.selectorHint}</span>
                </a>
              </li>
            ))}
            <li>
              <a href="/services/" class="mt-1 block rounded-bb-sm border-t border-ink-800 px-4 py-3 pt-4 text-sm font-medium text-signal-400 hover:bg-ink-800">
                View All Services →
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="relative" data-work-menu>
        <button
          type="button"
          id="work-menu-toggle"
          class="flex items-center gap-1.5 transition-colors hover:text-ink-50"
          aria-expanded="false"
          aria-controls="work-menu-panel"
        >
          Work
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class="h-4 w-4 transition-transform" aria-hidden="true" data-work-menu-chevron>
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>
        <div id="work-menu-panel" class="absolute left-1/2 top-full hidden w-80 -translate-x-1/2 pt-3" data-work-menu-panel>
          <ul class="rounded-bb-lg border border-ink-700 bg-ink-900 p-2 shadow-[0_10px_40px_-12px_rgba(0,0,0,0.55)]">
            {workLinks.map((link) => (
              <li>
                <a href={link.href} class="block rounded-bb-sm px-4 py-3 hover:bg-ink-800">
                  <span class="block text-sm font-semibold text-ink-50">{link.label}</span>
                  <span class="mt-0.5 block text-xs text-ink-300">{link.hint}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      {navLinks.map((link) => (
        <a href={link.href} class="transition-colors hover:text-ink-50">{link.label}</a>
      ))}
    </nav>

    <div class="hidden md:block">
      <StartProjectTrigger variant="primary" class="px-5 py-2.5 text-sm">Start a Project</StartProjectTrigger>
    </div>

    <button
      id="menu-toggle"
      class="flex h-11 w-11 items-center justify-center rounded-bb-sm text-ink-200 md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class="h-6 w-6" aria-hidden="true">
        <line x1="4" y1="7" x2="20" y2="7" />
        <line x1="4" y1="12" x2="20" y2="12" />
        <line x1="4" y1="17" x2="20" y2="17" />
      </svg>
    </button>
  </Container>

  <nav id="mobile-nav" aria-label="Mobile" class="hidden border-t border-ink-800 bg-ink-950 md:hidden">
    <Container class="flex flex-col gap-1 py-6 text-ink-200">
      <p class="px-1 pb-1 text-xs font-semibold uppercase tracking-[0.14em] text-ink-300">Services</p>
      {CATEGORIES.map((category) => (
        <a href={category.path} class="block rounded-bb-sm px-1 py-2.5 text-base">{category.navLabel}</a>
      ))}
      <a href="/services/" class="block rounded-bb-sm px-1 py-2.5 text-sm font-medium text-signal-400">View All Services →</a>
      <div class="my-3 border-t border-ink-800" />
      <p class="px-1 pb-1 text-xs font-semibold uppercase tracking-[0.14em] text-ink-300">Work</p>
      {workLinks.map((link) => (
        <a href={link.href} class="block rounded-bb-sm px-1 py-2.5 text-base">{link.label}</a>
      ))}
      <div class="my-3 border-t border-ink-800" />
      {navLinks.map((link) => (
        <a href={link.href} class="block px-1 py-2.5 text-base">{link.label}</a>
      ))}
      <StartProjectTrigger variant="primary" class="mt-3 w-full">Start a Project</StartProjectTrigger>
    </Container>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  const closeMenu = () => {
    mobileNav?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
  };

  toggle?.addEventListener('click', () => {
    const isHidden = mobileNav?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isHidden));
  });

  // Escape closes the open mobile menu and returns focus to the toggle
  // button, matching the standard disclosure-button keyboard pattern.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileNav && !mobileNav.classList.contains('hidden')) {
      closeMenu();
      toggle?.focus();
    }
  });

  // Desktop "Services" disclosure menu: standard button + menu pattern
  // (aria-expanded on the button, hidden attribute toggling the panel).
  // Opens on click or hover/focus-within, closes on Escape, outside
  // click, or losing focus — same interaction model as the mobile menu
  // above, just scoped to this one control.
  const setupMenu = (name: 'services' | 'work') => {
    const menu = document.querySelector<HTMLElement>(`[data-${name}-menu]`);
    const toggle = document.getElementById(`${name}-menu-toggle`);
    const panel = document.querySelector<HTMLElement>(`[data-${name}-menu-panel]`);
    const chevron = document.querySelector<SVGElement>(`[data-${name}-menu-chevron]`);
    if (!menu || !toggle || !panel) return;

    const open = () => {
      panel.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      chevron?.classList.add('rotate-180');
    };
    const close = () => {
      panel.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      chevron?.classList.remove('rotate-180');
    };
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => (isOpen() ? close() : open()));
    menu.addEventListener('mouseenter', open);
    menu.addEventListener('mouseleave', close);
    menu.addEventListener('focusout', (event) => {
      const next = (event as FocusEvent).relatedTarget as Node | null;
      if (!next || !menu.contains(next)) close();
    });
    document.addEventListener('click', (event) => {
      if (isOpen() && !menu.contains(event.target as Node)) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        close();
        toggle.focus();
      }
    });
  };
  setupMenu('services');
  setupMenu('work');

  // Collapse the mobile menu before the Start Project modal opens over
  // it, so it isn't left open (invisible behind the modal backdrop) once
  // the modal is closed.
  mobileNav?.querySelector('[data-start-project-trigger]')?.addEventListener('click', closeMenu);
</script>
