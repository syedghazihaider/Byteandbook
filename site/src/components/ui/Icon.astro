---
// Small original stroke-icon set — deliberately hand-drawn rather than
// pulling in an icon library dependency, keeping the bundle dependency-
// free per the "no unnecessary dependency" rule and matching the token
// system exactly (icons inherit currentColor).
interface Props {
  name:
    | 'trending-up'
    | 'search'
    | 'sparkles'
    | 'share-2'
    | 'layout'
    | 'code'
    | 'git-branch'
    | 'cloud'
    | 'cpu'
    | 'palette'
    | 'book-open';
  class?: string;
}
const { name, class: className = 'h-6 w-6' } = Astro.props;

const common = {
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.75',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
};
---

{name === 'trending-up' && (
  <svg {...common} class={className}><polyline points="3 17 9 11 13 15 21 6" /><polyline points="21 6 21 12" /><polyline points="21 6 15 6" /></svg>
)}
{name === 'search' && (
  <svg {...common} class={className}><circle cx="10" cy="10" r="6.5" /><line x1="20.5" y1="20.5" x2="14.5" y2="14.5" /></svg>
)}
{name === 'sparkles' && (
  <svg {...common} class={className}><path d="M11 3 L13 9 L19 11 L13 13 L11 19 L9 13 L3 11 L9 9 Z" /><path d="M19 3 L20 6 L23 7 L20 8 L19 11 L18 8 L15 7 L18 6 Z" /></svg>
)}
{name === 'share-2' && (
  <svg {...common} class={className}><circle cx="18" cy="5" r="2.5" /><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="19" r="2.5" /><line x1="8.3" y1="10.7" x2="15.7" y2="6.3" /><line x1="8.3" y1="13.3" x2="15.7" y2="17.7" /></svg>
)}
{name === 'layout' && (
  <svg {...common} class={className}><rect x="3" y="4" width="18" height="16" rx="2" /><line x1="10" y1="4" x2="10" y2="20" /><line x1="10" y1="12" x2="21" y2="12" /></svg>
)}
{name === 'code' && (
  <svg {...common} class={className}><polyline points="8 6 3 12 8 18" /><polyline points="16 6 21 12 16 18" /></svg>
)}
{name === 'git-branch' && (
  <svg {...common} class={className}><circle cx="6" cy="6" r="2.2" /><circle cx="6" cy="18" r="2.2" /><circle cx="18" cy="9" r="2.2" /><line x1="6" y1="8.2" x2="6" y2="15.8" /><path d="M6 8.2 C6 12, 12 9, 15.8 9" /></svg>
)}
{name === 'cloud' && (
  <svg {...common} class={className}><path d="M7 18h10a4 4 0 0 0 .4-7.98A5.5 5.5 0 0 0 7.1 9.5 4 4 0 0 0 7 18Z" /></svg>
)}
{name === 'cpu' && (
  <svg {...common} class={className}><rect x="7" y="7" width="10" height="10" rx="1.2" /><rect x="10" y="10" width="4" height="4" /><line x1="12" y1="2" x2="12" y2="5.5" /><line x1="12" y1="18.5" x2="12" y2="22" /><line x1="2" y1="12" x2="5.5" y2="12" /><line x1="18.5" y1="12" x2="22" y2="12" /></svg>
)}
{name === 'palette' && (
  <svg {...common} class={className}><circle cx="12" cy="12" r="9" /><circle cx="9" cy="10" r="1.1" fill="currentColor" /><circle cx="13" cy="8" r="1.1" fill="currentColor" /><circle cx="16" cy="11" r="1.1" fill="currentColor" /><circle cx="10" cy="15" r="1.1" fill="currentColor" /></svg>
)}
{name === 'book-open' && (
  <svg {...common} class={className}><path d="M12 6c-1.8-1.3-4.3-2-7-2v13c2.7 0 5.2.7 7 2" /><path d="M12 6c1.8-1.3 4.3-2 7-2v13c-2.7 0-5.2.7-7 2" /><line x1="12" y1="6" x2="12" y2="19" /></svg>
)}
