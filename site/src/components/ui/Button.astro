---
// Level 3 micro-interaction primitive: CSS-only hover/focus states,
// no JS. Variants: primary (signal accent), outline, ghost.
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'ghost';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'button';

const base =
  'inline-flex items-center justify-center gap-2 rounded-bb-md px-6 py-3 text-sm font-semibold ' +
  'transition-all duration-300 ease-out focus-visible:outline-2';

const variants = {
  primary:
    'bg-signal-500 text-ink-50 shadow-[0_0_0_1px_rgba(56,102,240,0.0)] ' +
    'hover:bg-signal-400 hover:-translate-y-0.5 hover:shadow-[0_12px_32px_-8px_rgba(56,102,240,0.45)] ' +
    'active:translate-y-0',
  outline:
    'border border-ink-600 text-ink-50 hover:border-signal-400 hover:text-signal-300 ' +
    'hover:-translate-y-0.5 active:translate-y-0',
  ghost:
    'text-ink-200 hover:text-ink-50 hover:bg-ink-800 active:bg-ink-700',
};
---

<Tag href={href} class={`${base} ${variants[variant]} ${className}`}>
  <slot />
</Tag>
