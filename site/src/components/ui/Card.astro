---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div
  class={`group rounded-bb-lg border border-ink-700 bg-ink-900/60 p-6 backdrop-blur
  transition-all duration-300 ease-out
  hover:border-ink-600 hover:bg-ink-900 hover:-translate-y-1
  hover:shadow-[0_20px_50px_-16px_rgba(0,0,0,0.6)] ${className}`}
>
  <slot />
</div>
