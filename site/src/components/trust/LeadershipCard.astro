---
// Renders one verified leadership profile (src/data/leadership.ts). Not
// currently used anywhere — the profile array is empty until real,
// approved leadership details exist — but built to the full
// LeadershipProfile shape now so publishing the first real profile
// needs no template work. Certifications and profile links only render
// when the record actually has them.
import type { LeadershipProfile } from '../../data/leadership';
import Card from '../ui/Card.astro';

interface Props {
  profile: LeadershipProfile;
}
const { profile } = Astro.props;

const profileLinks = [
  profile.linkedinUrl && { label: 'LinkedIn', href: profile.linkedinUrl },
  profile.githubUrl && { label: 'GitHub', href: profile.githubUrl },
  profile.professionalProfileUrl && { label: 'Profile', href: profile.professionalProfileUrl },
].filter((link): link is { label: string; href: string } => Boolean(link));
---

<Card class="h-full">
  <h3 class="text-lg font-semibold text-ink-50">{profile.fullName}</h3>
  <p class="text-sm font-medium text-signal-400">{profile.role}</p>
  <p class="mt-3 text-sm text-ink-300">{profile.bio}</p>

  {profile.expertiseAreas && profile.expertiseAreas.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {profile.expertiseAreas.map((area) => (
        <span class="rounded-full border border-ink-700 px-3 py-1 text-xs text-ink-300">{area}</span>
      ))}
    </div>
  )}

  {profile.certifications && profile.certifications.length > 0 && (
    <ul class="mt-4 space-y-1 border-t border-ink-800 pt-4">
      {profile.certifications.map((cert) => (
        <li class="text-xs text-ink-300">
          {cert.credentialUrl ? (
            <a href={cert.credentialUrl} target="_blank" rel="noopener" class="text-signal-400 hover:text-signal-300">{cert.name}</a>
          ) : cert.name} — {cert.issuer}
        </li>
      ))}
    </ul>
  )}

  {profileLinks.length > 0 && (
    <div class="mt-4 flex gap-4 border-t border-ink-800 pt-4">
      {profileLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener" class="text-sm font-medium text-signal-400 hover:text-signal-300">
          {link.label}
        </a>
      ))}
    </div>
  )}
</Card>
