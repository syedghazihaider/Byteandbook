---
// Phase 9 — SEO/GEO foundation. Every page passes its own `path` (the
// canonical route, always trailing-slash-terminated to match Astro's
// directory build output — see astro.config.mjs) so this layout can
// derive one absolute, self-referencing canonical URL and matching
// OG/Twitter metadata without each page re-deriving it. `noindex` opts
// a page (style-guide, 404) out of indexing without excluding it from
// rendering. `jsonLd` accepts zero or more page-specific schema.org
// objects (Service, BreadcrumbList, FAQPage) rendered alongside the
// sitewide Organization/WebSite graph below — real content only, see
// each page for what backs each field.
import StartProjectModal from '../components/project/StartProjectModal.astro';
import ChatLauncher from '../components/chat/ChatLauncher.astro';
import { verifiedSocialUrls } from '../config/site';
import { STYLES_HREF } from '../generated/styles-manifest';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const SITE_URL = 'https://byteandbook.com';
const SITE_NAME = 'ByteAndBook';

const { title, description, path, noindex = false, jsonLd = [] } = Astro.props;
const canonicalUrl = new URL(path, SITE_URL).toString();

// Sitewide identity graph — present on every page (not just the
// homepage) per standard practice, so any page can be understood in
// isolation. Only fields with real, verified values are included: no
// logo asset exists yet, no legal entity name confirmed (see /terms/
// section 27), no physical address/phone — all correctly omitted
// rather than invented. `sameAs` is sourced from config/site.ts and
// only appears at all once a verified external profile URL exists —
// see V2-5 report for why it's absent right now.
const organizationId = `${SITE_URL}/#organization`;
const websiteId = `${SITE_URL}/#website`;
const sameAs = verifiedSocialUrls();
const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: SITE_NAME,
      url: SITE_URL,
      description:
        'ByteAndBook is a digital technology and growth agency spanning marketing, software engineering, cloud infrastructure, and brand design.',
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'info@byteandbook.com',
        contactType: 'customer support',
      },
      ...(sameAs.length > 0 ? { sameAs } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: SITE_URL,
      name: SITE_NAME,
      publisher: { '@id': organizationId },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!--
      Compiled by the Tailwind CLI (npm run css:build) into a plain
      static file, linked directly rather than imported into the Astro/
      Vite module graph — see global.css and astro.config.mjs for why.
      V2.0.1: the filename is content-hashed (scripts/hash-css.mjs,
      src/generated/styles-manifest.ts) so a deployed CSS change always
      ships under a new URL — no stale-cache mismatch between an old
      cached stylesheet and newly deployed HTML/JS.
    -->
    <link rel="stylesheet" href={STYLES_HREF} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Only the weights actually used anywhere in the codebase (400
         regular body text, 500/600/700 via font-medium/semibold/bold —
         no font-extrabold usage exists) — a Phase 11 trim from the
         previous 400-800 range, which fetched an unused 800 weight for
         both families. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(siteGraph)} />
    {jsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
    <StartProjectModal />
    <ChatLauncher />
    <script>
      // Level 3: global scroll-reveal wiring. Adds .js-ready (which
      // arms the [data-reveal] hidden-until-scrolled CSS) only when
      // motion is actually going to run, so no-JS and reduced-motion
      // visitors always see full content with no dependency on script
      // timing.
      import { initScrollReveal, prefersReducedMotion } from '../scripts/motion';
      if (!prefersReducedMotion()) {
        document.documentElement.classList.add('js-ready');
      }
      initScrollReveal();
    </script>
  </body>
</html>
