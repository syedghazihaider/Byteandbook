---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import StartProjectTrigger from '../components/project/StartProjectTrigger.astro';
import HeroScene from '../components/three/HeroScene.astro';
import CapabilitySystem3D from '../components/three/CapabilitySystem3D.astro';
import { CATEGORIES } from '../lib/categories';

const process = [
  { step: '01', title: 'Discover', description: 'Define the problem, the audience, and what success actually looks like.' },
  { step: '02', title: 'Design', description: 'Plan the approach — visual, technical, or both — before we build anything.' },
  { step: '03', title: 'Build', description: 'Build and ship it, whether the deliverable is a logo or a Kubernetes cluster.' },
  { step: '04', title: 'Grow', description: 'Monitor, measure, and adjust against the goals set in discovery.' },
];

// Genuine, general FAQs — no fabricated claims about clients, pricing
// figures, or results. Also feeds Phase 9's FAQPage structured data.
const faqs = [
  {
    question: 'How is a project scoped and priced?',
    answer:
      "Every engagement is scoped individually. What we build ranges from a logo to a Kubernetes cluster, so there's no flat package price — we start from what you're building and price against that.",
  },
  {
    question: 'Do you only take on projects that span all three categories?',
    answer:
      'A project can be a single service (just SEO, just a logo, just a cloud migration) or span multiple categories. The process is the same either way.',
  },
  {
    question: 'What happens after I submit a project inquiry?',
    answer:
      "We review what you've shared and follow up to scope the work through the Discover, Design, Build, and Grow steps outlined above.",
  },
  {
    question: 'Is ByteAndBook a good fit for an early-stage or small project?',
    answer:
      'Yes. Single-service and smaller-scope engagements are welcome alongside larger, multi-service builds.',
  },
  {
    question: 'Is ByteAndBook a US-based agency?',
    answer:
      'Yes. ByteAndBook is a US-based, remote-first agency, and the project-request form uses US phone number formatting.',
  },
];
---

<BaseLayout
  title="ByteAndBook — Digital Technology & Growth Agency"
  description="ByteAndBook is a digital technology and growth agency spanning marketing, software engineering, cloud infrastructure, and brand design."
  path="/"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ]}
>
  <Header />

  <main id="main-content" tabindex="-1">
    <!-- Hero -->
    <section class="relative flex min-h-dvh items-center overflow-hidden pt-24">
      <!-- Static placeholder backdrop for the Phase 7 Level-1 3D hero
           scene. Deliberately restrained (grid + radial glow, no fake
           motion) rather than shipping a decorative gradient blob as a
           stand-in for real interactive 3D. -->
      <div class="pointer-events-none absolute inset-0">
        <div class="absolute inset-0 bg-[radial-gradient(60%_50%_at_50%_20%,rgba(56,102,240,0.18),transparent)]"></div>
        <div class="absolute inset-0 bg-[radial-gradient(45%_35%_at_82%_78%,rgba(214,64,159,0.10),transparent)]"></div>
        <div class="absolute inset-0 bg-[radial-gradient(40%_30%_at_10%_85%,rgba(232,153,46,0.08),transparent)]"></div>
        <div
          class="absolute inset-0 opacity-[0.08]"
          style="background-image: linear-gradient(var(--bb-ink-300) 1px, transparent 1px), linear-gradient(90deg, var(--bb-ink-300) 1px, transparent 1px); background-size: 64px 64px;"
        ></div>
        <HeroScene />
      </div>

      <Container class="relative z-10 py-24 text-center">
        <span class="inline-block rounded-full border border-signal-500/30 bg-ink-900/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-signal-400">
          Digital Technology &amp; Growth Agency
        </span>
        <h1 class="text-gradient-hero mx-auto mt-6 max-w-4xl text-display font-bold">
          Websites, Brands, Ebooks and Cloud Systems<br />Built by One Team
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-ink-300">
          ByteAndBook is a US-based agency that plans, designs, and builds
          the marketing, software, and infrastructure a business needs —
          under one roof, with one point of contact.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <StartProjectTrigger variant="primary">Start a Project</StartProjectTrigger>
          <Button href="/services/" variant="outline">Explore Services</Button>
        </div>
      </Container>
    </section>

    <!-- Categories -->
    <section id="services" class="relative scroll-mt-24 py-20">
      <CapabilitySystem3D count={CATEGORIES.length} />
      <Container>
        <SectionHeading eyebrow="How We're Organized" heading="Three Ways We Can Help" align="center" class="mx-auto max-w-2xl">
          <p class="mt-2 text-ink-300">
            Every service has its own dedicated page with a breakdown of
            how it actually works — start from whichever category matches
            what you need.
          </p>
        </SectionHeading>

        <div class="mt-12 grid gap-6 sm:grid-cols-3">
          {CATEGORIES.map((category, i) => (
            <a href={category.path} class="block" data-reveal data-service-card={i}>
              <div class="group h-full rounded-bb-lg border border-ink-700 bg-ink-900/60 p-6 backdrop-blur transition-colors duration-300 hover:border-ink-600">
                <div class={`mb-4 flex h-12 w-12 items-center justify-center rounded-bb-sm ${category.iconBgClass}`}>
                  <Icon name={category.serviceIds[0] === 'digital-marketing' ? 'trending-up' : category.serviceIds[0] === 'web-development' ? 'layout' : 'cloud'} class="h-6 w-6" />
                </div>
                <h3 class="text-lg font-semibold text-ink-50">{category.navLabel}</h3>
                <p class="mt-2 text-sm text-ink-300">{category.promise}</p>
                <span class={`mt-4 inline-flex items-center gap-1 text-sm font-medium ${category.badgeClass}`}>
                  {category.selectorLabel} →
                </span>
              </div>
            </a>
          ))}
        </div>
      </Container>
    </section>

    <!-- Approach -->
    <section id="approach" class="scroll-mt-24 py-20">
      <Container>
        <SectionHeading eyebrow="Process" heading="How We Work" align="center" class="mx-auto max-w-2xl" />
        <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {process.map((item) => (
            <div class="border-t border-ink-700 pt-5" data-reveal>
              <span class="font-display text-3xl font-bold text-ink-600">{item.step}</span>
              <h3 class="mt-3 text-lg font-semibold text-ink-50">{item.title}</h3>
              <p class="mt-2 text-sm text-ink-300">{item.description}</p>
            </div>
          ))}
        </div>

        <div class="mt-10 text-center">
          <Button href="/process/" variant="outline">See the full process</Button>
        </div>
      </Container>
    </section>

    <!-- FAQ -->
    <section class="py-20">
      <Container class="max-w-3xl">
        <SectionHeading eyebrow="FAQ" heading="Common Questions" align="center" class="mx-auto max-w-2xl" />
        <div class="mt-10 divide-y divide-ink-800 border-y border-ink-800">
          {faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-ink-50">
                {faq.question}
                <svg
                  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                  stroke-linecap="round" stroke-linejoin="round"
                  class="h-5 w-5 shrink-0 text-ink-300 transition-transform duration-200 group-open:rotate-45"
                  aria-hidden="true"
                >
                  <line x1="12" y1="5" x2="12" y2="19" />
                  <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
              </summary>
              <p class="mt-3 text-sm text-ink-300">{faq.answer}</p>
            </details>
          ))}
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="py-20">
      <Container>
        <div class="rounded-bb-lg border border-ink-700 bg-ink-900/60 px-8 py-16 text-center" data-reveal>
          <h2 class="text-section-title font-bold text-ink-50">Ready to Start a Project?</h2>
          <p class="mx-auto mt-4 max-w-xl text-ink-300">
            Tell us what you're building and which of these disciplines it
            touches — we'll scope it from there.
          </p>
          <div class="mt-8">
            <StartProjectTrigger variant="primary">Start a Project</StartProjectTrigger>
          </div>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>
