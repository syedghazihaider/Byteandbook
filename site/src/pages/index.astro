---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import StartProjectTrigger from '../components/project/StartProjectTrigger.astro';
import HeroScene from '../components/three/HeroScene.astro';
import CapabilitySystem3D from '../components/three/CapabilitySystem3D.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const pillars = [
  {
    name: 'Growth',
    icon: 'trending-up' as const,
    description: 'Marketing, SEO, GEO, and social systems built to convert attention into measurable leads.',
  },
  {
    name: 'Technology',
    icon: 'code' as const,
    description: 'Web and software engineering, built for real devices and real production traffic.',
  },
  {
    name: 'Infrastructure',
    icon: 'cloud' as const,
    description: 'DevOps, cloud architecture, and hardware specified around the workload, not a template.',
  },
  {
    name: 'Creative',
    icon: 'palette' as const,
    description: 'Brand systems and digital publishing built from geometry and typography up.',
  },
];

const process = [
  { step: '01', title: 'Discover', description: 'Define the problem, the audience, and what success actually measures.' },
  { step: '02', title: 'Design', description: 'Translate the strategy into a system — visual, technical, or both.' },
  { step: '03', title: 'Build', description: 'Engineer and ship, with the same discipline whether it’s a logo or a Kubernetes cluster.' },
  { step: '04', title: 'Grow', description: 'Monitor, measure, and iterate against the goals set in discovery.' },
];

// Genuine, general FAQs — no fabricated claims about clients, pricing
// figures, or results. Also feeds Phase 9's FAQPage structured data.
const faqs = [
  {
    question: 'How is a project scoped and priced?',
    answer:
      "Every engagement is scoped individually. The disciplines we cover — from a logo to a Kubernetes cluster — vary too much in scope for flat package pricing, so we start from what you're building and price against that.",
  },
  {
    question: 'Do you only take on full four-pillar engagements?',
    answer:
      'No — a project can be a single discipline (just SEO, just a logo, just a cloud migration) or span multiple pillars. The process is the same either way.',
  },
  {
    question: 'What happens after I submit a project inquiry?',
    answer:
      "We review what you've shared and follow up to scope the work through the Discover → Design → Build → Grow process outlined above.",
  },
  {
    question: 'Is ByteAndBook a good fit for an early-stage or small project?',
    answer:
      'Yes. Single-discipline and smaller-scope engagements are welcome, not just full-system builds.',
  },
];
---

<BaseLayout
  title="ByteAndBook — Digital Technology & Growth Agency"
  description="ByteAndBook is a digital technology and growth agency spanning marketing, software engineering, cloud infrastructure, and brand design."
  path="/"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ]}
>
  <Header />

  <main id="main-content" tabindex="-1">
    <!-- Hero -->
    <section class="relative flex min-h-screen items-center overflow-hidden pt-24">
      <!-- Static placeholder backdrop for the Phase 7 Level-1 3D hero
           scene. Deliberately restrained (grid + radial glow, no fake
           motion) rather than shipping a decorative gradient blob as a
           stand-in for real interactive 3D. -->
      <div class="pointer-events-none absolute inset-0">
        <div class="absolute inset-0 bg-[radial-gradient(60%_50%_at_50%_20%,rgba(56,102,240,0.16),transparent)]"></div>
        <div
          class="absolute inset-0 opacity-[0.08]"
          style="background-image: linear-gradient(var(--bb-ink-300) 1px, transparent 1px), linear-gradient(90deg, var(--bb-ink-300) 1px, transparent 1px); background-size: 64px 64px;"
        ></div>
        <HeroScene />
      </div>

      <Container class="relative z-10 py-24 text-center">
        <span class="inline-block rounded-full border border-ink-700 bg-ink-900/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-signal-400">
          Digital Technology &amp; Growth Agency
        </span>
        <h1 class="mx-auto mt-6 max-w-4xl text-5xl font-bold leading-[1.05] text-ink-50">
          Growth, engineered like infrastructure.
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-ink-300">
          ByteAndBook designs and builds the marketing, software, and
          infrastructure systems that take a business from idea to
          measurable growth — as one connected discipline, not
          disconnected vendors.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <StartProjectTrigger variant="primary">Start a Project</StartProjectTrigger>
          <Button href="/services/" variant="outline">Explore Services</Button>
        </div>
      </Container>
    </section>

    <!-- Pillars -->
    <section class="py-20">
      <Container>
        <SectionHeading eyebrow="How we're organized" heading="Four disciplines, one system" align="center" class="mx-auto max-w-2xl" />
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {pillars.map((pillar) => (
            <div data-reveal>
              <Card>
                <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-bb-sm bg-signal-500/10 text-signal-400">
                  <Icon name={pillar.icon} class="h-6 w-6" />
                </div>
                <h3 class="text-lg font-semibold text-ink-50">{pillar.name}</h3>
                <p class="mt-2 text-sm text-ink-300">{pillar.description}</p>
              </Card>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- Services -->
    <section id="services" class="relative scroll-mt-24 py-20">
      <CapabilitySystem3D count={services.length} />
      <Container>
        <SectionHeading eyebrow="Services" heading="Explained visually, not with stock photos" align="center" class="mx-auto max-w-2xl">
          <p class="mt-2 text-ink-300">
            Every service below gets its own dedicated, SEO-built page
            with an interactive breakdown of how it actually works.
          </p>
        </SectionHeading>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service, i) => (
            <a href={`/services/${service.id}/`} class="block" data-reveal data-service-card={i}>
              <Card class="h-full">
                <div class="mb-4 flex items-center justify-between">
                  <div class="flex h-12 w-12 items-center justify-center rounded-bb-sm bg-signal-500/10 text-signal-400">
                    <Icon name={service.data.icon as any} class="h-6 w-6" />
                  </div>
                  <span class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-300">
                    {service.data.pillar}
                  </span>
                </div>
                <h3 class="text-lg font-semibold text-ink-50">{service.data.title}</h3>
                <p class="mt-2 text-sm text-ink-300">{service.data.summary}</p>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-signal-400 transition-transform group-hover:translate-x-1">
                  Learn more →
                </span>
              </Card>
            </a>
          ))}
        </div>

        <div class="mt-10 text-center">
          <Button href="/services/" variant="outline">View all services</Button>
        </div>
      </Container>
    </section>

    <!-- Approach -->
    <section id="approach" class="scroll-mt-24 py-20">
      <Container>
        <SectionHeading eyebrow="Approach" heading="A consistent process, applied to every discipline" align="center" class="mx-auto max-w-2xl" />
        <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {process.map((item) => (
            <div class="border-t border-ink-700 pt-5" data-reveal>
              <span class="font-display text-3xl font-bold text-ink-700">{item.step}</span>
              <h3 class="mt-3 text-lg font-semibold text-ink-50">{item.title}</h3>
              <p class="mt-2 text-sm text-ink-300">{item.description}</p>
            </div>
          ))}
        </div>

        <div class="mt-10 text-center">
          <Button href="/process/" variant="outline">See the full process</Button>
        </div>
      </Container>
    </section>

    <!-- FAQ -->
    <section class="py-20">
      <Container class="max-w-3xl">
        <SectionHeading eyebrow="FAQ" heading="Common questions" align="center" class="mx-auto max-w-2xl" />
        <div class="mt-10 divide-y divide-ink-800 border-y border-ink-800">
          {faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-ink-50">
                {faq.question}
                <svg
                  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                  stroke-linecap="round" stroke-linejoin="round"
                  class="h-5 w-5 shrink-0 text-ink-400 transition-transform duration-200 group-open:rotate-45"
                  aria-hidden="true"
                >
                  <line x1="12" y1="5" x2="12" y2="19" />
                  <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
              </summary>
              <p class="mt-3 text-sm text-ink-300">{faq.answer}</p>
            </details>
          ))}
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="py-20">
      <Container>
        <div class="rounded-bb-lg border border-ink-700 bg-ink-900/60 px-8 py-16 text-center" data-reveal>
          <h2 class="text-3xl font-bold text-ink-50 md:text-4xl">Ready to start a project?</h2>
          <p class="mx-auto mt-4 max-w-xl text-ink-300">
            Tell us what you're building and which of these disciplines it
            touches — we'll scope it from there.
          </p>
          <div class="mt-8">
            <StartProjectTrigger variant="primary">Start a Project</StartProjectTrigger>
          </div>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>
