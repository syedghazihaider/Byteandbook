---
// V2-1: architecture-ready placeholder per CLAUDE.md ("This can initially
// be an architecture-ready page if no articles exist yet"). No fabricated
// articles. Full content collection + individual article routing is
// scoped to V2-7. noindex until real articles exist.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Insights — ByteAndBook"
  description="ByteAndBook Insights — articles on DevOps, Cloud, SEO, GEO, AI search, web and software development, and digital publishing. Coming soon."
  path="/insights/"
  noindex
>
  <Header />

  <main id="main-content" tabindex="-1" class="flex min-h-[70vh] items-center pt-24">
    <Container class="max-w-2xl text-center">
      <span class="inline-block rounded-full border border-ink-700 bg-ink-900/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-signal-400">
        Insights
      </span>
      <h1 class="mt-5 text-3xl font-bold text-ink-50 md:text-4xl">Articles are coming soon</h1>
      <p class="mx-auto mt-4 max-w-md text-ink-300">
        Insights will cover DevOps, cloud, SEO, GEO, AI search, web and
        software development, and digital publishing — with each article
        on its own dedicated page.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <Button href="/services/" variant="primary">Browse Services</Button>
        <Button href="/" variant="outline">Back to Home</Button>
      </div>
    </Container>
  </main>

  <Footer />
</BaseLayout>
