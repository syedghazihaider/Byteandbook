---
// V2-1: standalone Process page — replaces the homepage "#approach"
// anchor as the primary navigation destination for the client journey.
// Full interactive/3D storytelling treatment is scoped to V2-6; this
// page ships genuine, complete content using existing UI/motion
// primitives (data-reveal) rather than fake or placeholder copy.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/ui/Container.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import StartProjectTrigger from '../components/project/StartProjectTrigger.astro';
import Icon from '../components/ui/Icon.astro';

const SITE_URL = 'https://byteandbook.com';
const path = '/process/';

const stages = [
  {
    step: '01',
    title: 'Discovery',
    description:
      'We start by understanding what you’re building, who it’s for, and what problem it actually needs to solve — not a generic intake form.',
  },
  {
    step: '02',
    title: 'Requirements',
    description:
      'We translate that context into concrete requirements: what disciplines are involved, what constraints exist, and what "done" looks like.',
  },
  {
    step: '03',
    title: 'Scope',
    description:
      'Requirements become a defined scope of work — what’s included, what isn’t, and how the disciplines involved fit together.',
  },
  {
    step: '04',
    title: 'Quote',
    description:
      'You receive a quotation against that scope. Every engagement is priced individually against what’s actually being built.',
  },
  {
    step: '05',
    title: 'Confirmation',
    description:
      'Once you accept the scope and quote, the engagement is confirmed — this is the point a project request becomes a real order.',
  },
  {
    step: '06',
    title: 'Execution',
    description:
      'We build. Whether it’s a brand system, a codebase, or a cloud migration, execution follows the same disciplined process.',
  },
  {
    step: '07',
    title: 'Review',
    description:
      'You review the work against the agreed scope before anything is considered final — feedback loops happen here, not after delivery.',
  },
  {
    step: '08',
    title: 'Delivery',
    description:
      'Final assets, code, infrastructure, or systems are delivered and handed over, with documentation for what was built and how it works.',
  },
  {
    step: '09',
    title: 'Support',
    description:
      'Engagements don’t just end at delivery — ongoing support and iteration are available where the work calls for it.',
  },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Process', item: `${SITE_URL}${path}` },
  ],
};
---

<BaseLayout
  title="Process — ByteAndBook"
  description="How a ByteAndBook engagement runs, from discovery through delivery and support — Discovery, Requirements, Scope, Quote, Confirmation, Execution, Review, Delivery, Support."
  path={path}
  jsonLd={[breadcrumbJsonLd]}
>
  <Header />

  <main id="main-content" tabindex="-1">
    <section class="pt-32 pb-16">
      <Container>
        <nav class="mb-8 flex items-center gap-2 text-sm text-ink-300" aria-label="Breadcrumb">
          <a href="/" class="hover:text-ink-200">Home</a>
          <span>/</span>
          <span class="text-ink-200">Process</span>
        </nav>

        <div class="max-w-3xl">
          <span class="inline-block rounded-full border border-ink-700 bg-ink-900/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-signal-400">
            Process
          </span>
          <h1 class="mt-5 text-4xl font-bold text-ink-50 md:text-5xl">
            A consistent process, applied to every discipline.
          </h1>
          <p class="mt-5 text-lg text-ink-300">
            The same nine-stage process runs whether the engagement is a
            single service or spans all four pillars — from the first
            conversation to ongoing support.
          </p>
        </div>
      </Container>
    </section>

    <section class="border-t border-ink-800 py-16">
      <Container>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {stages.map((stage) => (
            <div data-reveal>
              <Card class="h-full">
                <span class="font-display text-3xl font-bold text-ink-700">{stage.step}</span>
                <h2 class="mt-3 text-lg font-semibold text-ink-50">{stage.title}</h2>
                <p class="mt-2 text-sm text-ink-300">{stage.description}</p>
              </Card>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <section class="border-t border-ink-800 py-16">
      <Container class="max-w-3xl">
        <h2 class="text-2xl font-bold text-ink-50">Request vs. order</h2>
        <p class="mt-4 text-sm text-ink-300">
          Submitting a project request through Start a Project is not a
          confirmed order. We review what you've shared, scope it, and send
          a quotation. A project only becomes a confirmed order once you
          accept that scope and the required payment or deposit is
          received.
        </p>
      </Container>
    </section>

    <section class="border-t border-ink-800 py-20">
      <Container>
        <div class="rounded-bb-lg border border-ink-700 bg-ink-900/60 px-8 py-16 text-center" data-reveal>
          <h2 class="text-3xl font-bold text-ink-50 md:text-4xl">Ready to start?</h2>
          <p class="mx-auto mt-4 max-w-xl text-ink-300">
            Tell us what you're building — Discovery starts with that
            conversation.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <StartProjectTrigger variant="primary">Start a Project</StartProjectTrigger>
            <Button href="/services/" variant="outline">Browse Services</Button>
          </div>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>
