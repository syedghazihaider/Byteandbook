---
// V2-1: route placeholder only. Full Refund & Cancellation Policy content
// is scoped to V2-4 per CLAUDE.md — no legal text is drafted here, and
// no claim that these terms override mandatory consumer law is made.
// noindex: incomplete legal content shouldn't be indexed/ranked yet.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Refund & Cancellation Policy — ByteAndBook"
  description="ByteAndBook Refund & Cancellation Policy — in progress."
  path="/refund-policy/"
  noindex
>
  <Header />

  <main id="main-content" tabindex="-1" class="flex min-h-[70vh] items-center pt-24">
    <Container class="max-w-2xl text-center">
      <span class="inline-block rounded-full border border-ink-700 bg-ink-900/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-signal-400">
        Refund &amp; Cancellation Policy
      </span>
      <h1 class="mt-5 text-3xl font-bold text-ink-50 md:text-4xl">This page is being finalized</h1>
      <p class="mx-auto mt-4 max-w-md text-ink-300">
        Our full Refund &amp; Cancellation Policy, covering confirmed
        orders and deposits, will be published here.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <Button href="/contact/" variant="primary">Contact Us</Button>
        <Button href="/" variant="outline">Back to Home</Button>
      </div>
    </Container>
  </main>

  <Footer />
</BaseLayout>
