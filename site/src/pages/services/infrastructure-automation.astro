---
// Phase 1-IA: category page 3 of 3. Composition: a connected pipeline
// list for services (fitting the infrastructure subject matter) and a
// horizontal dotted timeline for process — different from both
// growth-ai-discovery.astro and web-brand-publishing.astro.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Container from '../../components/ui/Container.astro';
import Icon from '../../components/ui/Icon.astro';
import StartProjectTrigger from '../../components/project/StartProjectTrigger.astro';
import { getCategory } from '../../lib/categories';

const category = getCategory('infrastructure-automation')!;
const allServices = await getCollection('services');
const services = category.serviceIds
  .map((id) => allServices.find((s) => s.id === id))
  .filter((s): s is (typeof allServices)[number] => Boolean(s));

const SITE_URL = 'https://byteandbook.com';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_URL}/services/` },
    { '@type': 'ListItem', position: 3, name: category.heading, item: `${SITE_URL}${category.path}` },
  ],
};
---

<BaseLayout
  title={`${category.heading} — ByteAndBook`}
  description="DevOps, cloud services, and computer hardware — pipelines, cloud infrastructure, and workstation or server builds set up to run reliably."
  path={category.path}
  jsonLd={[breadcrumbJsonLd]}
>
  <Header />

  <main id="main-content" tabindex="-1">
    <section class="pt-32 pb-16">
      <Container>
        <nav class="mb-8 flex items-center gap-2 text-sm text-ink-300" aria-label="Breadcrumb">
          <a href="/" class="hover:text-ink-200">Home</a>
          <span>/</span>
          <a href="/services/" class="hover:text-ink-200">Services</a>
          <span>/</span>
          <span class="text-ink-200">{category.heading}</span>
        </nav>

        <div class="max-w-3xl">
          <span class={`inline-block rounded-full border border-ink-700 bg-ink-900/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] ${category.badgeClass}`}>
            {category.eyebrow}
          </span>
          <h1 class="mt-5 text-page-title font-bold text-ink-50">{category.heading}</h1>
          <p class="mt-5 text-lg text-ink-300">{category.promise}</p>
          <div class="mt-8">
            <StartProjectTrigger variant="primary">Start a Project</StartProjectTrigger>
          </div>
        </div>
      </Container>
    </section>

    <!-- Who it's for: 2-column scenario list -->
    <section class="border-t border-ink-800 py-16">
      <Container>
        <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-ink-300">Who This Is For</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {category.whoFor.map((point) => (
            <div class="flex items-start gap-3 rounded-bb-lg border border-ink-800 p-5" data-reveal>
              <Icon name="cpu" class={`mt-0.5 h-5 w-5 shrink-0 ${category.badgeClass}`} />
              <p class="text-sm text-ink-200">{point}</p>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- What's included: connected pipeline list, not a card grid -->
    <section class="border-t border-ink-800 py-16">
      <Container class="max-w-3xl">
        <h2 class="text-2xl font-bold text-ink-50 md:text-3xl">What&rsquo;s Included</h2>
        <div class="mt-10 relative">
          <div class="absolute left-8 top-2 bottom-2 w-px bg-ink-700" aria-hidden="true"></div>
          <div class="space-y-6">
            {services.map((service) => (
              <a href={`/services/${service.id}/`} class="group relative flex items-start gap-6" data-reveal>
                <div class={`relative z-10 flex h-16 w-16 shrink-0 items-center justify-center rounded-full border border-ink-700 bg-ink-950 ${category.badgeClass}`}>
                  <Icon name={service.data.icon as any} class="h-7 w-7" />
                </div>
                <div class="flex-1 rounded-bb-lg border border-ink-800 p-5 transition-colors group-hover:border-ink-600">
                  <h3 class="text-lg font-semibold text-ink-50 group-hover:text-ink-100">{service.data.title}</h3>
                  <p class="mt-1 text-sm text-ink-300">{service.data.summary}</p>
                  <span class={`mt-3 inline-flex items-center gap-1 text-sm font-medium ${category.badgeClass}`}>
                    Learn more →
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </Container>
    </section>

    <!-- How the work runs: horizontal dotted timeline -->
    <section class="border-t border-ink-800 py-16">
      <Container>
        <h2 class="text-2xl font-bold text-ink-50 md:text-3xl">How the Work Runs</h2>
        <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          {category.howWeWork.map((step, i) => (
            <div class="relative" data-reveal>
              <div class="flex items-center gap-3">
                <span class={`flex h-3 w-3 shrink-0 rounded-full ${category.dotClass}`} aria-hidden="true"></span>
                {i < category.howWeWork.length - 1 && (
                  <span class="hidden h-px flex-1 bg-ink-700 sm:block" aria-hidden="true"></span>
                )}
              </div>
              <h3 class="mt-4 text-base font-semibold text-ink-50">{step.title}</h3>
              <p class="mt-2 text-sm text-ink-300">{step.description}</p>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <section class="py-20">
      <Container>
        <div class="rounded-bb-lg border border-ink-700 bg-ink-900/60 px-8 py-16 text-center" data-reveal>
          <h2 class="text-section-title font-bold text-ink-50">Ready to Fix Your Infrastructure?</h2>
          <p class="mx-auto mt-4 max-w-xl text-ink-300">
            Tell us what you&rsquo;re running today and where it breaks — we&rsquo;ll scope the fix from there.
          </p>
          <div class="mt-8">
            <StartProjectTrigger variant="primary">Start a Project</StartProjectTrigger>
          </div>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>
