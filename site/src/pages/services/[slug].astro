---
// Single dynamic route generating all 11 static service pages from the
// content collection, rather than 11 hand-duplicated .astro files —
// a deliberate refinement over the Phase 2 plan's one-file-per-service
// layout (see ARCHITECTURE.md Section 13). Each page is still emitted
// as its own static HTML file at build time (getStaticPaths), so the
// output and URLs are identical to what the original plan described.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Icon from '../../components/ui/Icon.astro';
import FlowSteps from '../../components/diagrams/FlowSteps.astro';
import NodeGraph3D from '../../components/three/NodeGraph3D.astro';
import HardwareExplode3D from '../../components/three/HardwareExplode3D.astro';
import DataEcosystem3D from '../../components/three/DataEcosystem3D.astro';
import BrandScene3D from '../../components/three/BrandScene3D.astro';
import BookScene3D from '../../components/three/BookScene3D.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const SITE_URL = 'https://byteandbook.com';
const path = `/services/${service.id}/`;
const canonicalUrl = new URL(path, SITE_URL).toString();

const allServices = await getCollection('services');
const pillarRelated = allServices
  .filter((s) => s.id !== service.id && s.data.pillar === service.data.pillar)
  .sort((a, b) => a.data.order - b.data.order);

// Explicit cross-pillar pairings called out in CLAUDE.md's GEO/internal-
// linking guidance (e.g. Web Development <-> DevOps) — these span
// different pillars, so the same-pillar grouping above wouldn't
// surface them on its own. Listed first so they always make the cut.
const crossLinks: Record<string, string[]> = {
  seo: ['geo'],
  geo: ['seo'],
  'digital-marketing': ['social-media-marketing'],
  'social-media-marketing': ['digital-marketing'],
  'web-development': ['devops', 'branding'],
  devops: ['web-development'],
  'software-development': ['cloud'],
  cloud: ['software-development'],
  branding: ['web-development'],
};
const crossRelated = (crossLinks[service.id] ?? [])
  .map((id) => allServices.find((s) => s.id === id))
  .filter((s): s is (typeof allServices)[number] => Boolean(s));

const seenIds = new Set<string>();
const related = [...crossRelated, ...pillarRelated]
  .filter((s) => {
    if (seenIds.has(s.id)) return false;
    seenIds.add(s.id);
    return true;
  })
  .slice(0, 3);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_URL}/services/` },
    { '@type': 'ListItem', position: 3, name: service.data.title, item: canonicalUrl },
  ],
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonicalUrl}#service`,
  name: service.data.title,
  description: service.data.metaDescription,
  url: canonicalUrl,
  category: service.data.pillar,
  provider: { '@id': `${SITE_URL}/#organization` },
};

// Every service page gets a Level 1 3D hero, grouped into the scene
// families documented in 3D_ART_DIRECTION.md — the family the page
// belongs to, not the individual service, decides which renderer runs.
// The Level 2 FlowSteps diagram (below) still renders for every page
// regardless of family, so the same data is always available as plain
// accessible markup too.
const infrastructureNetwork = new Set(['cloud', 'devops', 'web-development', 'software-development']);
const dataEcosystem = new Set(['digital-marketing', 'seo', 'geo', 'social-media-marketing']);

const isInfrastructure = infrastructureNetwork.has(service.id);
const isDevops = service.id === 'devops';
const isDataEcosystem = dataEcosystem.has(service.id);
const isHardware = service.id === 'computer-hardware';
const isBranding = service.id === 'branding';
const isEbook = service.id === 'ebook-publishing';
---

<BaseLayout
  title={`${service.data.title} — ByteAndBook`}
  description={service.data.metaDescription}
  path={path}
  jsonLd={[serviceJsonLd, breadcrumbJsonLd]}
>
  <Header />

  <main id="main-content" tabindex="-1">
    <section class="pt-32 pb-16">
      <Container>
        <nav class="mb-8 flex items-center gap-2 text-sm text-ink-300" aria-label="Breadcrumb">
          <a href="/" class="hover:text-ink-200">Home</a>
          <span>/</span>
          <a href="/services/" class="hover:text-ink-200">Services</a>
          <span>/</span>
          <span class="text-ink-200">{service.data.title}</span>
        </nav>

        <div class="max-w-3xl">
          <span class="inline-block rounded-full border border-ink-700 bg-ink-900/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-signal-400">
            {service.data.pillar}
          </span>
          <h1 class="mt-5 text-4xl font-bold text-ink-50 md:text-5xl">{service.data.title}</h1>
          <p class="mt-5 text-lg text-ink-300">{service.data.summary}</p>
        </div>
      </Container>
    </section>

    {isInfrastructure && service.data.flowSteps && (
      <section class="border-b border-ink-800 py-16">
        <Container>
          <NodeGraph3D steps={service.data.flowSteps} pulse={isDevops} />
        </Container>
      </section>
    )}

    {isDataEcosystem && service.data.flowSteps && (
      <section class="border-b border-ink-800 py-16">
        <Container>
          <DataEcosystem3D steps={service.data.flowSteps} />
        </Container>
      </section>
    )}

    {isHardware && (
      <section class="border-b border-ink-800 py-16">
        <Container>
          <HardwareExplode3D />
        </Container>
      </section>
    )}

    {isBranding && service.data.flowSteps && (
      <section class="border-b border-ink-800 py-16">
        <Container>
          <BrandScene3D steps={service.data.flowSteps} />
        </Container>
      </section>
    )}

    {isEbook && (
      <section class="border-b border-ink-800 py-16">
        <Container>
          <BookScene3D />
        </Container>
      </section>
    )}

    {service.data.flowSteps && service.data.flowSteps.length > 0 && (
      <section class="border-y border-ink-800 bg-ink-900/40 py-16" data-reveal>
        <Container>
          <h2 class="text-center text-sm font-semibold uppercase tracking-[0.18em] text-ink-300">
            How it works
          </h2>
          <div class="mt-10">
            <FlowSteps steps={service.data.flowSteps} />
          </div>
        </Container>
      </section>
    )}

    <section class="py-16">
      <Container class="max-w-3xl">
        <div class="prose-service text-ink-300">
          <Content />
        </div>

        {service.data.capabilities && service.data.capabilities.length > 0 && (
          <div class="mt-10 grid gap-x-8 gap-y-3 border-t border-ink-800 pt-8 sm:grid-cols-2">
            {service.data.capabilities.map((item) => (
              <div class="flex items-start gap-3 text-sm text-ink-200">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-signal-400" />
                {item}
              </div>
            ))}
          </div>
        )}
      </Container>
    </section>

    {related.length > 0 && (
      <section class="py-16">
        <Container>
          <h2 class="text-2xl font-bold text-ink-50">
            Related services
          </h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <a href={`/services/${r.id}/`} class="block" data-reveal>
                <Card class="h-full">
                  <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-bb-sm bg-signal-500/10 text-signal-400">
                    <Icon name={r.data.icon as any} class="h-6 w-6" />
                  </div>
                  <h3 class="text-lg font-semibold text-ink-50">{r.data.title}</h3>
                  <p class="mt-2 text-sm text-ink-300">{r.data.summary}</p>
                </Card>
              </a>
            ))}
          </div>
        </Container>
      </section>
    )}

    <section class="py-16">
      <Container>
        <div class="rounded-bb-lg border border-ink-700 bg-ink-900/60 px-8 py-14 text-center" data-reveal>
          <h2 class="text-2xl font-bold text-ink-50 md:text-3xl">
            Discuss a {service.data.title.toLowerCase()} project
          </h2>
          <p class="mx-auto mt-3 max-w-xl text-ink-300">
            Tell us where you're starting from and what you need — we'll
            scope it against the process above.
          </p>
          <div class="mt-7">
            <Button href="/contact/" variant="primary">Start a Project</Button>
          </div>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>
