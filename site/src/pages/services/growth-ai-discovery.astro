---
// Phase 1-IA: category page 1 of 3. Composition deliberately differs from
// the other two category pages (checklist + numbered service list +
// horizontal process strip) rather than reusing one grid template three
// times — see CLAUDE.md's "avoid the repeated card-grid pattern" note.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Container from '../../components/ui/Container.astro';
import Icon from '../../components/ui/Icon.astro';
import StartProjectTrigger from '../../components/project/StartProjectTrigger.astro';
import { getCategory } from '../../lib/categories';

const category = getCategory('growth-ai-discovery')!;
const allServices = await getCollection('services');
const services = category.serviceIds
  .map((id) => allServices.find((s) => s.id === id))
  .filter((s): s is (typeof allServices)[number] => Boolean(s));

const SITE_URL = 'https://byteandbook.com';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_URL}/services/` },
    { '@type': 'ListItem', position: 3, name: category.heading, item: `${SITE_URL}${category.path}` },
  ],
};
---

<BaseLayout
  title={`${category.heading} — ByteAndBook`}
  description="Digital marketing, SEO, GEO, and social media services that get your business found by customers and by AI search tools."
  path={category.path}
  jsonLd={[breadcrumbJsonLd]}
>
  <Header />

  <main id="main-content" tabindex="-1">
    <section class="pt-32 pb-16">
      <Container>
        <nav class="mb-8 flex items-center gap-2 text-sm text-ink-300" aria-label="Breadcrumb">
          <a href="/" class="hover:text-ink-200">Home</a>
          <span>/</span>
          <a href="/services/" class="hover:text-ink-200">Services</a>
          <span>/</span>
          <span class="text-ink-200">{category.heading}</span>
        </nav>

        <div class="max-w-3xl">
          <span class={`inline-block rounded-full border border-ink-700 bg-ink-900/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] ${category.badgeClass}`}>
            {category.eyebrow}
          </span>
          <h1 class="mt-5 text-page-title font-bold text-ink-50">{category.heading}</h1>
          <p class="mt-5 text-lg text-ink-300">{category.promise}</p>
          <div class="mt-8">
            <StartProjectTrigger variant="primary">Start a Project</StartProjectTrigger>
          </div>
        </div>
      </Container>
    </section>

    <!-- Who it's for: checklist, not a card grid -->
    <section class="border-t border-ink-800 py-16">
      <Container class="max-w-3xl">
        <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-ink-300">Who This Is For</h2>
        <ul class="mt-6 space-y-4">
          {category.whoFor.map((point) => (
            <li class="flex items-start gap-3 text-base text-ink-200" data-reveal>
              <Icon name="check-circle" class={`mt-0.5 h-5 w-5 shrink-0 ${category.badgeClass}`} />
              {point}
            </li>
          ))}
        </ul>
      </Container>
    </section>

    <!-- What's included: numbered service list, not a card grid -->
    <section class="border-t border-ink-800 py-16">
      <Container>
        <h2 class="text-2xl font-bold text-ink-50 md:text-3xl">What&rsquo;s Included</h2>
        <div class="mt-10 divide-y divide-ink-800 border-y border-ink-800">
          {services.map((service, i) => (
            <a href={`/services/${service.id}/`} class="group flex flex-col gap-2 py-6 sm:flex-row sm:items-center sm:gap-8" data-reveal>
              <span class="font-display text-2xl font-bold text-ink-600 sm:w-12">{String(i + 1).padStart(2, '0')}</span>
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-ink-50 group-hover:text-ink-100">{service.data.title}</h3>
                <p class="mt-1 text-sm text-ink-300">{service.data.summary}</p>
              </div>
              <span class={`inline-flex shrink-0 items-center gap-1 text-sm font-medium ${category.badgeClass}`}>
                Learn more →
              </span>
            </a>
          ))}
        </div>
      </Container>
    </section>

    <!-- How the work runs: horizontal process strip -->
    <section class="border-t border-ink-800 py-16">
      <Container>
        <h2 class="text-2xl font-bold text-ink-50 md:text-3xl">How the Work Runs</h2>
        <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {category.howWeWork.map((step, i) => (
            <div class="border-t border-ink-700 pt-5" data-reveal>
              <span class="font-display text-2xl font-bold text-ink-600">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 text-base font-semibold text-ink-50">{step.title}</h3>
              <p class="mt-2 text-sm text-ink-300">{step.description}</p>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <section class="py-20">
      <Container>
        <div class="rounded-bb-lg border border-ink-700 bg-ink-900/60 px-8 py-16 text-center" data-reveal>
          <h2 class="text-section-title font-bold text-ink-50">Ready to Get Found?</h2>
          <p class="mx-auto mt-4 max-w-xl text-ink-300">
            Tell us where your traffic and visibility stand today, and which of these services fits — we&rsquo;ll scope it from there.
          </p>
          <div class="mt-8">
            <StartProjectTrigger variant="primary">Start a Project</StartProjectTrigger>
          </div>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>
