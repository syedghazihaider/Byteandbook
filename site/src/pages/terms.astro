---
// V2-4: real, published Terms of Service, replacing the V2-1
// placeholder. Now indexable — a Terms page is standard practice for a
// professional agency site and reinforces GEO entity/service clarity
// per CLAUDE.md. Jurisdiction is deliberately phrased conservatively
// (see section 27) rather than naming a specific state/country, because
// ByteAndBook's governing legal entity has not been confirmed — see the
// V2-4 report for what still needs deciding before this can be tightened.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/ui/Container.astro';
import LegalToc from '../components/legal/LegalToc.astro';
import { TERMS_VERSION } from '../lib/legal';

const SITE_URL = 'https://byteandbook.com';
const path = '/terms/';
const lastUpdated = 'August 2026';

const sections = [
  { id: 'introduction', label: 'Introduction' },
  { id: 'definitions', label: 'Definitions' },
  { id: 'project-requests', label: 'Project requests' },
  { id: 'proposals-quotations', label: 'Proposals / quotations' },
  { id: 'scope-acceptance', label: 'Scope acceptance' },
  { id: 'order-confirmation', label: 'Order confirmation' },
  { id: 'payments-deposits', label: 'Payments and deposits' },
  { id: 'non-refundable-confirmed-orders', label: 'Non-refundable confirmed orders' },
  { id: 'cancellations', label: 'Cancellations' },
  { id: 'change-requests', label: 'Change requests / scope changes' },
  { id: 'revisions', label: 'Revisions' },
  { id: 'client-responsibilities', label: 'Client responsibilities' },
  { id: 'client-supplied-content', label: 'Content/material supplied by client' },
  { id: 'accuracy-of-instructions', label: 'Accuracy of client instructions' },
  { id: 'project-timelines', label: 'Project timelines' },
  { id: 'client-caused-delays', label: 'Client-caused delays' },
  { id: 'third-party-costs', label: 'Third-party products/services/costs' },
  { id: 'intellectual-property', label: 'Intellectual property' },
  { id: 'pre-existing-tools', label: 'Pre-existing tools/frameworks' },
  { id: 'portfolio-permission', label: 'Portfolio/case-study permission' },
  { id: 'confidentiality', label: 'Confidentiality' },
  { id: 'acceptable-use', label: 'Acceptable use' },
  { id: 'prohibited-content', label: 'Illegal/prohibited content or activities' },
  { id: 'suspension-termination', label: 'Suspension/termination' },
  { id: 'limitation-of-liability', label: 'Limitation of liability' },
  { id: 'force-majeure', label: 'Force majeure' },
  { id: 'ai-assistant-informational', label: 'AI Assistant — informational only' },
  { id: 'governing-law', label: 'Governing law / jurisdiction' },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Terms of Service', item: `${SITE_URL}${path}` },
  ],
};
---

<BaseLayout
  title="Terms of Service — ByteAndBook"
  description="ByteAndBook's Terms of Service — how project requests, quotations, order confirmation, payments, cancellations, and intellectual property work."
  path={path}
  jsonLd={[breadcrumbJsonLd]}
>
  <Header />

  <main id="main-content" tabindex="-1">
    <section class="pt-32 pb-12">
      <Container class="max-w-3xl">
        <nav class="mb-8 flex items-center gap-2 text-sm text-ink-300" aria-label="Breadcrumb">
          <a href="/" class="hover:text-ink-200">Home</a>
          <span>/</span>
          <span class="text-ink-200">Terms of Service</span>
        </nav>

        <span class="inline-block rounded-full border border-ink-700 bg-ink-900/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-signal-400">
          Legal
        </span>
        <h1 class="mt-5 text-4xl font-bold text-ink-50 md:text-5xl">Terms of Service</h1>
        <p class="mt-5 text-lg text-ink-300">
          These Terms govern any project request, quotation, order, or engagement with ByteAndBook.
          Please read them before submitting a project request or confirming an order.
        </p>
        <p class="mt-4 text-sm text-ink-400">
          Last updated: {lastUpdated} · Terms Version: {TERMS_VERSION}
        </p>
      </Container>
    </section>

    <section class="border-t border-ink-800 py-10">
      <Container class="max-w-3xl">
        <LegalToc items={sections} />
      </Container>
    </section>

    <section class="py-10">
      <Container class="max-w-3xl">
        <div class="prose-service space-y-12 text-ink-300">
          <section id="introduction">
            <h2 class="text-2xl font-bold text-ink-50">1. Introduction</h2>
            <p class="mt-3">
              These Terms of Service ("Terms") govern your use of the ByteAndBook website and any
              project request, quotation, order, or engagement between you ("Client") and
              ByteAndBook ("we", "us", "ByteAndBook"). By submitting a project request, accepting a
              quotation, or confirming an order, you agree to these Terms.
            </p>
          </section>

          <section id="definitions">
            <h2 class="text-2xl font-bold text-ink-50">2. Definitions</h2>
            <p class="mt-3">
              "Project Request" means an inquiry submitted through the Start a Project flow or by
              direct email. "Proposal" or "Quotation" means a scope of work and price we provide in
              response to a Project Request. "Order" means a Proposal the Client has accepted and
              ByteAndBook has confirmed, following receipt of any required payment or deposit.
              "Deliverables" means the work product ByteAndBook produces under a confirmed Order.
            </p>
          </section>

          <section id="project-requests">
            <h2 class="text-2xl font-bold text-ink-50">3. Project requests</h2>
            <p class="mt-3">
              Submitting a Project Request — whether through the Start a Project form or by email —
              is an inquiry only. It does not create an Order, a binding contract, or any payment
              obligation. We review each Project Request and follow up to scope the work.
            </p>
          </section>

          <section id="proposals-quotations">
            <h2 class="text-2xl font-bold text-ink-50">4. Proposals / quotations</h2>
            <p class="mt-3">
              Following a Project Request, we may provide a Proposal describing the scope, timeline,
              and price of the proposed work. A Proposal is an offer, not a confirmed Order, and
              remains subject to change until accepted by the Client and confirmed by ByteAndBook.
            </p>
          </section>

          <section id="scope-acceptance">
            <h2 class="text-2xl font-bold text-ink-50">5. Scope acceptance</h2>
            <p class="mt-3">
              A Proposal becomes an accepted scope once the Client confirms agreement to it (in
              writing, including by email). Acceptance of scope is a precondition to Order
              confirmation — work does not begin, and payment is not requested, before scope is
              agreed.
            </p>
          </section>

          <section id="order-confirmation">
            <h2 class="text-2xl font-bold text-ink-50">6. Order confirmation</h2>
            <p class="mt-3">
              An Order is confirmed only once (a) the Client has accepted the scope of a Proposal,
              and (b) any required payment or deposit described in that Proposal has been received
              by ByteAndBook. Before both conditions are met, no Order exists.
            </p>
          </section>

          <section id="payments-deposits">
            <h2 class="text-2xl font-bold text-ink-50">7. Payments and deposits</h2>
            <p class="mt-3">
              Payment terms, including any required deposit, are set out in the applicable Proposal.
              Payment instructions are provided after scope acceptance — see our
              <a href="/checkout/" class="text-signal-400 hover:text-signal-300">Checkout</a> page. We do not accept payment for undefined or unscoped work.
            </p>
          </section>

          <section id="non-refundable-confirmed-orders">
            <h2 class="text-2xl font-bold text-ink-50">8. Non-refundable confirmed orders</h2>
            <p class="mt-3">
              Once an Order is confirmed and the required payment or deposit has been received,
              payments are non-refundable. Cancellation after confirmation does not automatically
              create an entitlement to a refund. This is subject to (a) any applicable law that
              requires otherwise, and (b) any exception ByteAndBook expressly agrees to in writing.
              See our <a href="/refund-policy/" class="text-signal-400 hover:text-signal-300">Refund &amp; Cancellation Policy</a> for full detail.
            </p>
          </section>

          <section id="cancellations">
            <h2 class="text-2xl font-bold text-ink-50">9. Cancellations</h2>
            <p class="mt-3">
              A Project Request may be withdrawn at any time before an Order is confirmed, at no
              cost. Cancelling a confirmed Order is subject to section 8 above and our Refund &amp;
              Cancellation Policy — work already performed and third-party costs already committed
              (see section 17) are not automatically reimbursed.
            </p>
          </section>

          <section id="change-requests">
            <h2 class="text-2xl font-bold text-ink-50">10. Change requests / scope changes</h2>
            <p class="mt-3">
              Requests to change the agreed scope after Order confirmation are handled as a scope
              change, not automatically included in the original price or timeline. Material changes
              may require a revised quotation and/or timeline, which we will provide before
              proceeding.
            </p>
          </section>

          <section id="revisions">
            <h2 class="text-2xl font-bold text-ink-50">11. Revisions</h2>
            <p class="mt-3">
              Where a Proposal includes a defined number of revision rounds, additional revisions
              beyond that number may be quoted separately. Revisions that materially change the
              agreed scope are treated as a change request under section 10.
            </p>
          </section>

          <section id="client-responsibilities">
            <h2 class="text-2xl font-bold text-ink-50">12. Client responsibilities</h2>
            <p class="mt-3">
              The Client is responsible for providing timely feedback, approvals, access credentials,
              and any materials reasonably required for ByteAndBook to perform the work, and for the
              accuracy of information the Client supplies.
            </p>
          </section>

          <section id="client-supplied-content">
            <h2 class="text-2xl font-bold text-ink-50">13. Content/material supplied by client</h2>
            <p class="mt-3">
              The Client warrants that any content, media, brand assets, or materials it supplies for
              use in the project are either owned by the Client or properly licensed for the intended
              use, and that ByteAndBook's use of them as instructed will not infringe a third party's
              rights.
            </p>
          </section>

          <section id="accuracy-of-instructions">
            <h2 class="text-2xl font-bold text-ink-50">14. Accuracy of client instructions</h2>
            <p class="mt-3">
              ByteAndBook relies on the accuracy of instructions, requirements, and information
              provided by the Client. We are not responsible for outcomes that result from inaccurate,
              incomplete, or outdated information supplied by the Client.
            </p>
          </section>

          <section id="project-timelines">
            <h2 class="text-2xl font-bold text-ink-50">15. Project timelines</h2>
            <p class="mt-3">
              Timelines given in a Proposal are estimates based on the scope agreed and the
              information available at the time. Timelines may shift where scope changes, third-party
              dependencies are delayed, or the Client does not provide timely feedback/materials.
            </p>
          </section>

          <section id="client-caused-delays">
            <h2 class="text-2xl font-bold text-ink-50">16. Client-caused delays</h2>
            <p class="mt-3">
              Where a delay is caused by the Client — late feedback, late approvals, late payment, or
              late provision of required materials or access — ByteAndBook is not responsible for any
              resulting schedule slip, and the project timeline is adjusted accordingly.
            </p>
          </section>

          <section id="third-party-costs">
            <h2 class="text-2xl font-bold text-ink-50">17. Third-party products/services/costs</h2>
            <p class="mt-3">
              Some projects involve third-party costs — for example, where applicable: domains,
              hosting, cloud infrastructure, software licenses, APIs, advertising spend, platform
              fees, plugins, stock/media licenses, external contractors or vendors, or
              payment-processing fees where legally permitted to pass through. Not every category
              applies to every project. Where a third-party cost has already been committed or
              incurred on the Client's behalf, that cost may be non-refundable regardless of the
              status of the ByteAndBook engagement itself.
            </p>
          </section>

          <section id="intellectual-property">
            <h2 class="text-2xl font-bold text-ink-50">18. Intellectual property</h2>
            <p class="mt-3">
              Unless otherwise agreed in writing, ownership of final Deliverables created specifically
              for the Client transfers to the Client upon full payment for the applicable Order.
              ByteAndBook retains the right to reuse general knowledge, techniques, and non-Client-
              specific components developed in the course of the work.
            </p>
          </section>

          <section id="pre-existing-tools">
            <h2 class="text-2xl font-bold text-ink-50">19. Pre-existing tools/frameworks</h2>
            <p class="mt-3">
              ByteAndBook may use pre-existing tools, frameworks, libraries, templates, or internal
              components in delivering a project. These remain ByteAndBook's property (or that of
              their respective licensors) and are licensed to the Client for use as part of the
              Deliverables, not transferred outright, except where separately agreed in writing.
            </p>
          </section>

          <section id="portfolio-permission">
            <h2 class="text-2xl font-bold text-ink-50">20. Portfolio/case-study permission</h2>
            <p class="mt-3">
              ByteAndBook will not present a Client's project as a portfolio item, case study, or
              testimonial unless the Client has separately and explicitly authorized that use. No
              such permission is implied by an Order.
            </p>
          </section>

          <section id="confidentiality">
            <h2 class="text-2xl font-bold text-ink-50">21. Confidentiality</h2>
            <p class="mt-3">
              Each party agrees to keep the other's confidential business information private, and to
              use it only for the purpose of the engagement, except where disclosure is required by
              law or already public.
            </p>
          </section>

          <section id="acceptable-use">
            <h2 class="text-2xl font-bold text-ink-50">22. Acceptable use</h2>
            <p class="mt-3">
              The Client agrees to use ByteAndBook's services, deliverables, and website only for
              lawful purposes and in a manner that does not infringe the rights of, or restrict the
              use of, any third party.
            </p>
          </section>

          <section id="prohibited-content">
            <h2 class="text-2xl font-bold text-ink-50">23. Illegal/prohibited content or activities</h2>
            <p class="mt-3">
              ByteAndBook will not knowingly build, host, market, or otherwise support content or
              activity that is illegal, fraudulent, infringing, or intended to cause harm. We may
              decline or discontinue any engagement that we reasonably believe involves such content
              or activity.
            </p>
          </section>

          <section id="suspension-termination">
            <h2 class="text-2xl font-bold text-ink-50">24. Suspension/termination</h2>
            <p class="mt-3">
              ByteAndBook may suspend or terminate an engagement where the Client materially breaches
              these Terms, fails to pay amounts due, or requests unlawful work. Termination does not
              waive any payment already due for work performed, or entitle the Client to a refund of
              amounts covered by section 8.
            </p>
          </section>

          <section id="limitation-of-liability">
            <h2 class="text-2xl font-bold text-ink-50">25. Limitation of liability</h2>
            <p class="mt-3">
              To the maximum extent permitted by applicable law, ByteAndBook's total liability arising
              out of an engagement is limited to the amount actually paid by the Client for the
              relevant Order. ByteAndBook is not liable for indirect, incidental, or consequential
              damages. Nothing in these Terms excludes liability that cannot lawfully be excluded.
            </p>
          </section>

          <section id="force-majeure">
            <h2 class="text-2xl font-bold text-ink-50">26. Force majeure</h2>
            <p class="mt-3">
              Neither party is liable for delay or failure to perform caused by events reasonably
              outside its control, including natural disasters, internet/infrastructure outages,
              third-party service failures, or other circumstances a reasonable business could not
              have prevented.
            </p>
          </section>

          <section id="ai-assistant-informational">
            <h2 class="text-2xl font-bold text-ink-50">27. AI Assistant — informational only</h2>
            <p class="mt-3">
              Where offered, the ByteAndBook AI Assistant provides general, informational answers
              about our services, process, and policies. Its answers do not constitute a quotation,
              scope acceptance, a confirmed order, or professional or legal advice, and cannot bind
              ByteAndBook to pricing, timelines, or terms beyond what is stated elsewhere on this site.
              A quotation, scope, and confirmed order are only established through the process
              described in sections 3–6 above. See our Privacy Policy for how AI Assistant messages
              are handled.
            </p>
          </section>

          <section id="governing-law">
            <h2 class="text-2xl font-bold text-ink-50">28. Governing law / jurisdiction</h2>
            <p class="mt-3">
              These Terms are governed by the laws applicable to ByteAndBook's place of business, and
              any dispute arising under them is subject to the exclusive jurisdiction of the competent
              courts of that place, without regard to conflict-of-law principles. ByteAndBook will
              update this section to name a specific governing jurisdiction once its operating legal
              entity is finalized.
            </p>
          </section>
        </div>

        <div class="mt-16 rounded-bb-lg border border-ink-700 bg-ink-900/60 p-8 text-center" data-reveal>
          <h2 class="text-xl font-semibold text-ink-50">Questions about these Terms?</h2>
          <p class="mx-auto mt-3 max-w-md text-sm text-ink-300">
            Contact us at <a href="mailto:info@byteandbook.com" class="text-signal-400 hover:text-signal-300">info@byteandbook.com</a>.
          </p>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>
