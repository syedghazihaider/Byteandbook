---
// V2-5: real, permanent Work page, replacing the V2-1 placeholder.
// Explains methodology, capability evidence, and the evidence
// standard for future case studies — genuinely useful content that
// doesn't depend on having a published case study yet. The case-study
// grid below is wired to src/data/caseStudies.ts and renders nothing
// but an honest empty-state message while that array is empty; adding
// a real, client-authorized entry there makes it appear automatically.
// Indexable: unlike the V2-1 "coming later" placeholder, this page now
// has substantial permanent content (methodology, evidence standards)
// independent of whether any case study exists — see V2-5 report.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Icon from '../components/ui/Icon.astro';
import StartProjectTrigger from '../components/project/StartProjectTrigger.astro';
import CaseStudyCard from '../components/trust/CaseStudyCard.astro';
import TrustBadge from '../components/trust/TrustBadge.astro';
import { caseStudies } from '../data/caseStudies';

const SITE_URL = 'https://byteandbook.com';
const path = '/work/';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const evidenceStandards = [
  {
    icon: 'shield' as const,
    title: 'Client-authorized only',
    description: 'A project is never published as work here without the client\'s explicit, separate permission. An engagement does not imply that permission on its own.',
  },
  {
    icon: 'check-circle' as const,
    title: 'Verified With a Real Source',
    description: 'Where a metric or result is shown, it links to something a visitor can actually check: a live URL, a public source, or client-provided evidence.',
  },
  {
    icon: 'code' as const,
    title: 'No invented numbers',
    description: 'We do not publish traffic, revenue, or performance figures we cannot back with real evidence. An unverifiable number is left out, not estimated.',
  },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Work', item: `${SITE_URL}${path}` },
  ],
};
---

<BaseLayout
  title="Work | ByteAndBook"
  description="How ByteAndBook documents project work: our methodology and the evidence standard verified case studies must meet before publication."
  path={path}
  jsonLd={[breadcrumbJsonLd]}
>
  <Header />

  <main id="main-content" tabindex="-1">
    <section class="pt-32 pb-16">
      <Container class="max-w-3xl">
        <nav class="mb-8 flex items-center gap-2 text-sm text-ink-300" aria-label="Breadcrumb">
          <a href="/" class="hover:text-ink-200">Home</a>
          <span>/</span>
          <span class="text-ink-200">Work</span>
        </nav>

        <span class="inline-block rounded-full border border-ink-700 bg-ink-900/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-signal-400">
          Work
        </span>
        <h1 class="mt-5 text-page-title font-bold text-ink-50">How We Work<br />And Prove It</h1>
        <p class="mt-5 text-lg text-ink-300">
          This page explains our methodology and the evidence standard every case study has to meet
          before it's published. It is not a placeholder, and not a page of invented results.
        </p>
      </Container>
    </section>

    <section class="border-t border-ink-800 py-16">
      <Container class="max-w-3xl">
        <SectionHeading eyebrow="Methodology" heading="The Same Process Every Time" />
        <p class="mt-4 text-ink-300">
          Every engagement runs through the same nine-stage process: Discovery, Requirements, Scope,
          Quote, Confirmation, Execution, Review, Delivery, Support, regardless of which discipline
          it touches. That consistency is what makes the work reviewable after the fact, not just
          during it.
        </p>
        <a href="/process/" class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-signal-400 hover:text-signal-300">
          See the full process →
        </a>
      </Container>
    </section>

    <section class="border-t border-ink-800 py-16">
      <Container>
        <SectionHeading eyebrow="Capability Areas" heading="What We Build" align="center" class="mx-auto max-w-2xl" />
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => (
            <a href={`/services/${service.id}/`} class="block rounded-bb-md border border-ink-700 bg-ink-900/60 px-5 py-4 text-sm text-ink-200 transition-colors hover:border-signal-400 hover:text-signal-300">
              {service.data.title}
            </a>
          ))}
        </div>
      </Container>
    </section>

    <section class="border-t border-ink-800 py-16">
      <Container class="max-w-3xl">
        <SectionHeading eyebrow="Evidence Standards" heading="What It Takes for Work to Appear Here" />
        <div class="mt-10 grid gap-8 sm:grid-cols-2">
          {evidenceStandards.map((item) => (
            <TrustBadge icon={item.icon} title={item.title} description={item.description} />
          ))}
        </div>
        <p class="mt-8 text-sm text-ink-300">
          The same standard applies to <a href="/insights/" class="text-signal-400 hover:text-signal-300">Insights articles</a>.
        </p>
      </Container>
    </section>

    <section class="border-t border-ink-800 py-16">
      <Container>
        <SectionHeading eyebrow="Case Studies" heading="Verified Project Work" align="center" class="mx-auto max-w-2xl" />

        {caseStudies.length > 0 ? (
          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {caseStudies.map((caseStudy) => (
              <CaseStudyCard caseStudy={caseStudy} />
            ))}
          </div>
        ) : (
          <div class="mx-auto mt-10 max-w-xl rounded-bb-lg border border-ink-700 bg-ink-900/60 p-10 text-center" data-reveal>
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-signal-500/10 text-signal-400">
              <Icon name="search" class="h-6 w-6" />
            </div>
            <p class="mt-5 text-ink-300">
              Verified case studies will be published here as client-authorized work becomes
              available. Until then, the service pages above show how each discipline actually
              works, and the evidence standard above shows what any future case study has to meet.
            </p>
          </div>
        )}
      </Container>
    </section>

    <section class="border-t border-ink-800 py-20">
      <Container>
        <div class="rounded-bb-lg border border-ink-700 bg-ink-900/60 px-8 py-16 text-center" data-reveal>
          <h2 class="text-section-title font-bold text-ink-50">Want to Be the First Case Study?</h2>
          <p class="mx-auto mt-4 max-w-xl text-ink-300">
            Tell us what you're building. We'll scope it against the same process described above.
          </p>
          <div class="mt-8">
            <StartProjectTrigger variant="primary">Start a Project</StartProjectTrigger>
          </div>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>
