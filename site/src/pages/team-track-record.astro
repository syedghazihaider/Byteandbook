---
// Team Track Record: real reviews ByteAndBook's own engineers and sales
// manager earned on their individual freelance-platform profiles while
// on ByteAndBook's payroll, before byteandbook.com existed as a business
// site. Framed honestly as the team's track record, not as formal
// ByteAndBook client testimonials implying direct engagements with the
// ByteAndBook business entity (see src/data/teamReviews.ts's header).
// Deliberately its own page, separate from /case-studies/ and /work/'s
// named, client-authorized case studies, so the two evidence standards
// never blend. No Review/AggregateRating schema per Google's guidance on
// self-serving review rich snippets — plain testimonial content only.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import StartProjectTrigger from '../components/project/StartProjectTrigger.astro';
import { teamReviews, teamReviewStats, elizabethVideoShoutouts } from '../data/teamReviews';

const SITE_URL = 'https://byteandbook.com';
const path = '/team-track-record/';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Work', item: `${SITE_URL}/work/` },
    { '@type': 'ListItem', position: 3, name: 'Team Track Record', item: `${SITE_URL}${path}` },
  ],
};
---

<BaseLayout
  title="Team Track Record: Real Freelance Reviews | ByteAndBook"
  description="Real, verifiable reviews ByteAndBook's engineers and sales manager earned on their individual freelance profiles before ByteAndBook existed as a site."
  path={path}
  jsonLd={[breadcrumbJsonLd]}
>
  <Header />

  <main id="main-content" tabindex="-1">
    <section class="pt-32 pb-16">
      <Container class="max-w-3xl">
        <nav class="mb-8 flex flex-wrap items-center gap-2 text-sm text-ink-300" aria-label="Breadcrumb">
          <a href="/" class="hover:text-ink-200">Home</a>
          <span>/</span>
          <a href="/work/" class="hover:text-ink-200">Work</a>
          <span>/</span>
          <span class="text-ink-200">Team Track Record</span>
        </nav>

        <span class="inline-block rounded-full border border-ink-700 bg-ink-900/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-signal-400">
          Team Track Record
        </span>
        <h1 class="mt-5 text-page-title font-bold text-ink-50">Reviews Our Team Earned, Before ByteAndBook</h1>
        <p class="mt-5 text-lg text-ink-300">
          These are verified reviews our engineers and sales manager earned on their individual
          freelance-platform profiles while already on ByteAndBook's payroll, before
          byteandbook.com existed as a business site. They're our team's own track record, not
          formal ByteAndBook client engagements — that distinct, client-authorized evidence lives
          on our <a href="/case-studies/" class="text-signal-400 hover:text-signal-300">case studies</a> page.
        </p>
        <p class="mt-4 text-sm text-ink-400">
          {teamReviewStats.totalReviews} reviews · {teamReviewStats.withWrittenFeedback} with written feedback · {teamReviewStats.averageRating.toFixed(1)} average rating
        </p>
      </Container>
    </section>

    {teamReviews.map((member) => (
      <section class="border-t border-ink-800 py-16">
        <Container>
          <SectionHeading eyebrow={member.discipline} heading={member.member} />
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {member.reviews.map((r) => (
              <div class="rounded-bb-lg border border-ink-700 bg-ink-900/60 p-6" data-reveal>
                <div class="flex items-center justify-between gap-3">
                  <p class="text-sm font-semibold text-ink-50">{r.reviewer}</p>
                  <span class="shrink-0 rounded-full border border-ink-700 px-2.5 py-0.5 text-xs font-semibold text-signal-400">{r.rating.toFixed(1)}/5</span>
                </div>
                <p class="mt-1 text-xs uppercase tracking-[0.1em] text-ink-400">{r.jobTitle}{r.company ? ` · ${r.company}` : ''}</p>
                {r.feedback && <p class="mt-3 text-sm text-ink-300">&ldquo;{r.feedback}&rdquo;</p>}
              </div>
            ))}
          </div>
        </Container>
      </section>
    ))}

    <section id="elizabeth" class="border-t border-ink-800 py-16">
      <Container class="max-w-3xl">
        <SectionHeading eyebrow="Sales · Creative & Design" heading="Elizabeth" />
        <p class="mt-4 text-ink-300">
          Elizabeth is ByteAndBook's Sales Manager. Separately from ByteAndBook's core services,
          she has also taken on freelance creative/design work for individual streamers and
          content creators — channel branding, thumbnails, emotes, and character art — while on
          ByteAndBook's payroll. It's a genuinely different kind of work from ByteAndBook's core
          service lineup, so it's kept in its own bucket here rather than blended into the reviews
          above. The clips below are unsolicited video shoutouts from that work.
        </p>
        <div class="mt-8 grid gap-6 sm:grid-cols-3">
          {elizabethVideoShoutouts.map((v) => (
            <div class="rounded-bb-lg border border-ink-700 bg-ink-900/60 p-4" data-reveal>
              <video controls preload="none" poster={v.poster} class="w-full rounded-bb-md bg-ink-950" playsinline>
                <source src={v.video} type="video/mp4" />
              </video>
              <p class="mt-3 text-sm text-ink-300">{v.summary}</p>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <section class="border-t border-ink-800 py-20">
      <Container>
        <div class="rounded-bb-lg border border-ink-700 bg-ink-900/60 px-8 py-16 text-center" data-reveal>
          <h2 class="text-section-title font-bold text-ink-50">Have a Project for This Team?</h2>
          <p class="mx-auto mt-4 max-w-xl text-ink-300">
            Tell us what you're building, and we'll scope it against the same process described on
            our <a href="/process/" class="text-signal-400 hover:text-signal-300">process page</a>.
          </p>
          <div class="mt-8">
            <StartProjectTrigger variant="primary">Start a Project</StartProjectTrigger>
          </div>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>
